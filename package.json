{
  "name": "charted-currents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Provenance-aware historical exploration of the Greater Caribbean, 1650–1730.",
  "scripts": {
    "preflight": "node scripts/preflight.mjs && node scripts/scan-private-leaks.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check",
    "verify": "npm run check && npm run build",
    "data:build": "python3 data/pipeline/build_corpus.py",
    "data:validate": "node scripts/validate-published-data.mjs",
    "data:summary": "node scripts/data-summary.mjs",
    "data:verify-crespo-acquisition": "python3 data/pipeline/adapters/crespo_profile.py --verify-only",
    "data:profile-crespo": "python3 data/pipeline/adapters/crespo_profile.py",
    "data:extract-crespo": "python3 data/pipeline/adapters/crespo_extract.py",
    "data:audit-crespo-mdbtools": "python3 scripts/audit-crespo-mdbtools.py",
    "data:test": "python3 -m unittest discover tests",
    "data:test-negative": "node tests/test_validator_negative.mjs",
    "research:check-access": "node scripts/check-research-access.mjs",
    "research:test-diagnostic": "node tests/test_research_access_diagnostic.mjs",
    "refs:sync": "node scripts/sync-visual-references.mjs",
    "review:behavioral": "node scripts/capture-reviews.mjs --behavioral-only",
    "review:capture": "node scripts/capture-reviews.mjs",
    "review:capture-packet4": "node scripts/capture-reviews.mjs --packet=packet4",
    "review:capture-packet5": "node scripts/capture-reviews.mjs --packet=packet5",
    "packet:report": "node scripts/packet-report.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/libre-caslon-text": "5.3.0",
    "astro": "7.2.9",
    "maplibre-gl": "6.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/edonahue/charted-currents"
  },
  "homepage": "https://github.com/edonahue/charted-currents",
  "engines": {
    "node": ">=22.19.0 <23"
  }
}
