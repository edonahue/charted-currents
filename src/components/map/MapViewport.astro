---
/**
 * src/components/map/MapViewport.astro
 *
 * MapLibre map viewport with SSR-rendered place locators, selection hierarchy,
 * transatlantic fitBounds camera behavior, and epistemic route legend.
 */
import "maplibre-gl/dist/maplibre-gl.css";
import entitiesData from "../../../public/data/entities.json";

const PLACES = (entitiesData.places || []).map((p) => ({
  id: p.id,
  label: p.canonical_name,
  region: p.region,
  precision: p.geographic_precision.replace(/_/g, " "),
}));
---

<section class="map-viewport" aria-label="Greater Caribbean map" data-component="map-viewport">
  <div id="charted-currents-map" class="map-viewport__canvas" tabindex="0" aria-label="Interactive map canvas. Use arrow keys to pan, plus and minus to zoom."></div>

  <!-- Epistemic map legend -->
  <aside class="map-epistemic-legend" aria-label="Map notation">
    <span class="map-epistemic-legend__icon" aria-hidden="true">┄</span>
    <span class="map-epistemic-legend__text">Dashed lines connect documented endpoints · Not observed sailing tracks</span>
  </aside>

  <!-- Perceivable locator browser for keyboard, screen-reader, and quick place navigation -->
  <div class="map-locator-browser" data-locator-browser>
    <button
      type="button"
      class="map-locator-browser__toggle"
      aria-expanded="false"
      aria-controls="map-locator-menu"
      data-locator-toggle
    >
      <span class="map-locator-browser__icon" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="7" cy="7" r="5.5" />
          <circle cx="7" cy="7" r="2" fill="currentColor" />
        </svg>
      </span>
      <span>Browse places</span>
      <span class="map-locator-browser__count" aria-hidden="true">({PLACES.length})</span>
    </button>
    <nav
      id="map-locator-menu"
      class="map-locator-browser__menu"
      aria-label="Historical places and locators"
      data-locator-menu
      hidden
    >
      <div class="map-locator-browser__header">
        <p class="panel-kicker">Historical Places</p>
        <span class="map-locator-browser__caption">Sourced Corpus (1684–1712)</span>
      </div>
      <ul class="map-locator-browser__list">
        {PLACES.map((place) => (
          <li>
            <button
              type="button"
              class="map-locator-browser__item"
              data-place-id={place.id}
              data-selection-id={place.id}
            >
              <span class="map-locator-browser__item-label">{place.label}</span>
              <span class="map-locator-browser__item-region">{place.region}</span>
            </button>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <p class="map-viewport__status sr-only" data-map-status role="status" aria-live="polite"></p>
</section>

<script>
  import { AttributionControl, LngLatBounds, Map, NavigationControl, setWorkerUrl } from "maplibre-gl";
  import workerUrl from "maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url";
  import type { PublishedPortFeatureCollection, PublishedRouteFeatureCollection, Selection } from "../../lib/domain/types";
  import { publishedDataUrl } from "../../lib/data/loadPublished";
  import { applyBasemapVisualPolicy } from "../../lib/map/applyVisualPolicy";
  import { INITIAL_MAP_STYLE_URL, INITIAL_MAP_VIEW, SELECTION_CAMERA } from "../../lib/map/config";
  import { recordSelectionTrigger } from "../../lib/map/interactionState";
  import { PROJECT_MARKER_VISUAL_POLICY } from "../../lib/map/visualPolicy";
  import { selectionStore } from "../../lib/state/selection";
  import { timeFilterStore, type TimeFilterState } from "../../lib/state/timeFilter";

  setWorkerUrl(workerUrl);

  const container = document.getElementById("charted-currents-map");
  const status = document.querySelector<HTMLElement>("[data-map-status]");
  const locatorBrowser = document.querySelector<HTMLElement>("[data-locator-browser]");
  const locatorToggle = document.querySelector<HTMLButtonElement>("[data-locator-toggle]");
  const locatorMenu = document.querySelector<HTMLElement>("[data-locator-menu]");
  const locatorItems = Array.from(document.querySelectorAll<HTMLButtonElement>(".map-locator-browser__item"));

  let map: Map | null = null;
  let previousSelectedFeatureId: string | null = null;
  let hoveredFeatureId: string | null = null;
  let portsData: PublishedPortFeatureCollection | null = null;
  let routesData: PublishedRouteFeatureCollection | null = null;
  let activeTimeFilter: TimeFilterState = timeFilterStore.get();

  async function initMap() {
    if (!container) return;

    try {
      map = new Map({
        container,
        style: INITIAL_MAP_STYLE_URL,
        center: INITIAL_MAP_VIEW.center,
        zoom: INITIAL_MAP_VIEW.zoom,
        minZoom: 2,
        maxZoom: 9,
        bearing: 0,
        pitch: 0,
        dragRotate: false,
        pitchWithRotate: false,
        touchPitch: false,
        attributionControl: false,
      });

      map.addControl(
        new AttributionControl({
          compact: true,
          customAttribution: '<a href="https://openfreemap.org" target="_blank" rel="noopener">OpenFreeMap</a> | <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">© OpenStreetMap</a>',
        }),
        "bottom-right"
      );

      map.addControl(
        new NavigationControl({
          showCompass: false,
          showZoom: true,
          visualizePitch: false,
        }),
        "bottom-right"
      );

      map.on("load", () => {
        if (!map || !container) return;
        container.dataset.mapReady = "true";
        applyBasemapVisualPolicy(map);
        loadHistoricalData(map);
      });

      map.on("idle", () => {
        if (!container) return;
        container.dataset.mapIdle = "true";
      });

      selectionStore.subscribe((selection) => {
        syncMapToSelection(selection);
      });

      initLocatorBrowser();
    } catch (err) {
      console.error("Map initialization failed:", err);
      if (status) status.textContent = "Map failed to initialize.";
    }
  }

  async function loadHistoricalData(m: Map) {
    try {
      const [portsRes, routesRes] = await Promise.all([
        fetch(publishedDataUrl("ports")),
        fetch(publishedDataUrl("routes")),
      ]);

      if (!portsRes.ok || !routesRes.ok) {
        throw new Error("Failed to load historical data artifacts");
      }

      portsData = await portsRes.json();
      routesData = await routesRes.json();

      // 1. Add Routes Source
      m.addSource("historical-routes", {
        type: "geojson",
        data: routesData!,
      });

      // Render schematic dashed line
      m.addLayer({
        id: "historical-routes-line",
        type: "line",
        source: "historical-routes",
        paint: {
          "line-color": "#7a5840",
          "line-width": 1.8,
          "line-opacity": 0.45,
          "line-dasharray": [3, 2.5],
        },
      });

      // Hit-target layer for routes
      m.addLayer({
        id: "historical-routes-hit-target",
        type: "line",
        source: "historical-routes",
        paint: {
          "line-width": 18,
          "line-color": "transparent",
          "line-opacity": 0,
        },
      });

      // 2. Add Ports Source
      m.addSource("historical-ports", {
        type: "geojson",
        data: portsData!,
      });

      // Concentric outer ring layer
      m.addLayer({
        id: "historical-ports-outer-ring",
        type: "circle",
        source: "historical-ports",
        paint: {
          "circle-radius": [
            "case",
            ["boolean", ["feature-state", "selected"], false],
            PROJECT_MARKER_VISUAL_POLICY.selectedOuterRingRadiusPx,
            ["boolean", ["feature-state", "hover"], false],
            PROJECT_MARKER_VISUAL_POLICY.outerRingRadiusPx + 1,
            PROJECT_MARKER_VISUAL_POLICY.outerRingRadiusPx,
          ],
          "circle-color": "transparent",
          "circle-stroke-color": [
            "case",
            ["boolean", ["feature-state", "selected"], false],
            PROJECT_MARKER_VISUAL_POLICY.colors.ringSelected,
            PROJECT_MARKER_VISUAL_POLICY.colors.ring,
          ],
          "circle-stroke-width": [
            "case",
            ["boolean", ["feature-state", "selected"], false],
            PROJECT_MARKER_VISUAL_POLICY.selectedStrokeWidthPx,
            ["boolean", ["feature-state", "hover"], false],
            PROJECT_MARKER_VISUAL_POLICY.strokeWidthPx + 0.5,
            PROJECT_MARKER_VISUAL_POLICY.strokeWidthPx,
          ],
          "circle-stroke-opacity": [
            "case",
            ["boolean", ["feature-state", "selected"], false],
            1,
            ["boolean", ["feature-state", "hover"], false],
            0.95,
            0.75,
          ],
        },
      });

      // Solid core dot layer
      m.addLayer({
        id: "historical-ports-core",
        type: "circle",
        source: "historical-ports",
        paint: {
          "circle-radius": [
            "case",
            ["boolean", ["feature-state", "selected"], false],
            PROJECT_MARKER_VISUAL_POLICY.selectedRadiusPx,
            PROJECT_MARKER_VISUAL_POLICY.radiusPx,
          ],
          "circle-color": [
            "case",
            ["boolean", ["feature-state", "selected"], false],
            PROJECT_MARKER_VISUAL_POLICY.colors.coreSelected,
            PROJECT_MARKER_VISUAL_POLICY.colors.core,
          ],
          "circle-stroke-color": PROJECT_MARKER_VISUAL_POLICY.colors.halo,
          "circle-stroke-width": 1.5,
        },
      });

      // Clean label layer
      m.addLayer({
        id: "historical-ports-label",
        type: "symbol",
        source: "historical-ports",
        layout: {
          "text-field": ["get", "canonical_name"],
          "text-variable-anchor": ["top", "bottom", "right", "left"],
          "text-radial-offset": 0.9,
          "text-justify": "auto",
          "text-size": 12,
          "text-optional": true,
        },
        paint: {
          "text-color": PROJECT_MARKER_VISUAL_POLICY.colors.labelText,
          "text-halo-color": PROJECT_MARKER_VISUAL_POLICY.colors.labelHalo,
          "text-halo-width": 1.5,
          "text-opacity": 0.92,
        },
      });

      // Hit-target layer for ports
      m.addLayer({
        id: "historical-ports-hit-target",
        type: "circle",
        source: "historical-ports",
        paint: {
          "circle-radius": 24,
          "circle-color": "transparent",
          "circle-opacity": 0,
        },
      });

      // Pointer listeners for ports
      m.on("mouseenter", "historical-ports-hit-target", (e) => {
        m.getCanvas().style.cursor = "pointer";
        const feature = e.features?.[0];
        if (feature?.id) {
          hoveredFeatureId = String(feature.id);
          m.setFeatureState({ source: "historical-ports", id: hoveredFeatureId }, { hover: true });
        }
      });

      m.on("mouseleave", "historical-ports-hit-target", () => {
        m.getCanvas().style.cursor = "";
        if (hoveredFeatureId) {
          m.setFeatureState({ source: "historical-ports", id: hoveredFeatureId }, { hover: false });
          hoveredFeatureId = null;
        }
      });

      m.on("click", "historical-ports-hit-target", (e) => {
        const feature = e.features?.[0];
        if (feature && feature.properties?.id) {
          recordSelectionTrigger({
            modality: "pointer",
            origin: "map",
            returnTarget: container,
          });
          selectionStore.set({ kind: "port", id: String(feature.properties.id) });
        }
      });

      // Pointer listeners for routes
      m.on("mouseenter", "historical-routes-hit-target", () => {
        m.getCanvas().style.cursor = "pointer";
      });

      m.on("mouseleave", "historical-routes-hit-target", () => {
        m.getCanvas().style.cursor = "";
      });

      m.on("click", "historical-routes-hit-target", (e) => {
        const feature = e.features?.[0];
        if (!feature || !feature.properties) return;
        const props = feature.properties;
        const recCount = Number(props.record_count) || 1;
        recordSelectionTrigger({
          modality: "pointer",
          origin: "map",
          returnTarget: container,
        });
        if (recCount > 1) {
          selectionStore.set({ kind: "voyage", id: String(props.route_group_id || props.id) });
        } else if (props.vessel_id) {
          selectionStore.set({ kind: "ship", id: String(props.vessel_id) });
        }
      });

      timeFilterStore.subscribe((filter) => {
        activeTimeFilter = filter;
        updateRouteVisualHierarchy(selectionStore.get(), activeTimeFilter);
      });

      syncMapToSelection(selectionStore.get());
    } catch (err) {
      console.error("Failed to load historical map data:", err);
    }
  }

  function updateRouteVisualHierarchy(selection: Selection, timeFilter: TimeFilterState): void {
    if (!map || !map.getLayer("historical-routes-line")) return;

    const filterActive = timeFilter.id !== "all";
    const startY = timeFilter.startYear;
    const endY = timeFilter.endYear;

    // Helper condition: is route or any constituent member inside active temporal filter?
    const inTimeCondition: any = filterActive
      ? [
          "any",
          ...Array.from({ length: endY - startY + 1 }, (_, i) => [
            "in",
            startY + i,
            ["get", "member_years"],
          ]),
          [
            "all",
            [">=", ["get", "associated_record_year"], startY],
            ["<=", ["get", "associated_record_year"], endY],
          ],
        ]
      : true;

    if (selection && selection.kind === "port") {
      const isConnectedToPort: any = [
        "any",
        ["==", ["get", "origin_place_id"], selection.id],
        ["==", ["get", "destination_place_id"], selection.id],
      ];

      map.setPaintProperty("historical-routes-line", "line-opacity", [
        "case",
        ["all", isConnectedToPort, inTimeCondition],
        0.95,
        isConnectedToPort,
        0.16, // Connected but out-of-period remains visibly dimmed
        inTimeCondition,
        0.12,
        0.02,
      ]);
      map.setPaintProperty("historical-routes-line", "line-width", [
        "case",
        ["all", isConnectedToPort, inTimeCondition],
        2.4,
        isConnectedToPort,
        1.6,
        1.4,
      ]);
      map.setPaintProperty("historical-routes-line", "line-color", "#7a5840");
    } else if (selection && selection.kind === "ship") {
      const isSelectedShip: any = [
        "in",
        selection.id,
        ["get", "constituent_vessel_ids"],
      ];

      map.setPaintProperty("historical-routes-line", "line-opacity", [
        "case",
        ["all", isSelectedShip, inTimeCondition],
        1.0,
        isSelectedShip,
        0.25, // Selected ship but out-of-period
        inTimeCondition,
        0.12,
        0.02,
      ]);
      map.setPaintProperty("historical-routes-line", "line-width", [
        "case",
        isSelectedShip,
        2.8,
        1.4,
      ]);
      map.setPaintProperty("historical-routes-line", "line-color", [
        "case",
        isSelectedShip,
        "#c85a32",
        "#7a5840",
      ]);
    } else if (selection && selection.kind === "voyage") {
      const isSelectedGroup: any = [
        "any",
        ["==", ["get", "route_group_id"], selection.id],
        ["==", ["get", "id"], selection.id],
      ];

      map.setPaintProperty("historical-routes-line", "line-opacity", [
        "case",
        ["all", isSelectedGroup, inTimeCondition],
        1.0,
        isSelectedGroup,
        0.25,
        inTimeCondition,
        0.12,
        0.02,
      ]);
      map.setPaintProperty("historical-routes-line", "line-width", [
        "case",
        isSelectedGroup,
        2.8,
        1.4,
      ]);
      map.setPaintProperty("historical-routes-line", "line-color", [
        "case",
        isSelectedGroup,
        "#c85a32",
        "#7a5840",
      ]);
    } else {
      // Default: no selection
      map.setPaintProperty("historical-routes-line", "line-opacity", [
        "case",
        inTimeCondition,
        0.45,
        0.04,
      ]);
      map.setPaintProperty("historical-routes-line", "line-width", [
        "case",
        inTimeCondition,
        1.8,
        1.2,
      ]);
      map.setPaintProperty("historical-routes-line", "line-color", "#7a5840");
    }
  }

  function syncMapToSelection(selection: Selection): void {
    if (!map || !map.getSource("historical-ports")) return;

    if (previousSelectedFeatureId) {
      map.setFeatureState(
        { source: "historical-ports", id: previousSelectedFeatureId },
        { selected: false }
      );
      previousSelectedFeatureId = null;
    }

    const isDesktop = window.innerWidth >= 768;
    const isReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (selection && selection.kind === "port") {
      const portFeature = portsData?.features.find((f) => f.properties.id === selection.id);
      if (portFeature) {
        previousSelectedFeatureId = portFeature.id;
        map.setFeatureState(
          { source: "historical-ports", id: portFeature.id },
          { selected: true }
        );

        const padding = isDesktop
          ? { right: 380, top: 40, bottom: 40, left: 40 }
          : { bottom: 260, top: 40, left: 20, right: 20 };

        if (isReducedMotion) {
          map.jumpTo({ center: portFeature.geometry.coordinates as [number, number], padding });
        } else {
          map.easeTo({
            center: portFeature.geometry.coordinates as [number, number],
            padding,
            duration: SELECTION_CAMERA.durationMs,
          });
        }
      }
    } else if (selection && selection.kind === "ship") {
      const routeFeature = routesData?.features.find((f) => f.properties.constituent_vessel_ids.includes(selection.id));
      if (routeFeature && routeFeature.geometry.coordinates.length >= 2) {
        const bounds = new LngLatBounds();
        for (const coord of routeFeature.geometry.coordinates) {
          bounds.extend(coord as [number, number]);
        }

        const padding = isDesktop
          ? { right: 420, top: 70, bottom: 70, left: 60 }
          : { bottom: 280, top: 50, left: 30, right: 30 };

        if (isReducedMotion) {
          map.fitBounds(bounds, { padding, maxZoom: 5.5, duration: 0 });
        } else {
          map.fitBounds(bounds, {
            padding,
            maxZoom: 5.5,
            duration: SELECTION_CAMERA.durationMs,
          });
        }
      }
    } else if (selection && selection.kind === "voyage") {
      const matchingRoutes = routesData?.features.filter(
        (r) => r.properties.route_group_id === selection.id || r.properties.id === selection.id
      );
      if (matchingRoutes && matchingRoutes.length > 0) {
        const bounds = new LngLatBounds();
        for (const r of matchingRoutes) {
          for (const coord of r.geometry.coordinates) {
            bounds.extend(coord as [number, number]);
          }
        }
        const padding = isDesktop
          ? { right: 420, top: 70, bottom: 70, left: 60 }
          : { bottom: 280, top: 50, left: 30, right: 30 };

        if (isReducedMotion) {
          map.fitBounds(bounds, { padding, maxZoom: 5.5, duration: 0 });
        } else {
          map.fitBounds(bounds, {
            padding,
            maxZoom: 5.5,
            duration: SELECTION_CAMERA.durationMs,
          });
        }
      }
    }

    updateRouteVisualHierarchy(selection, activeTimeFilter);
  }

  function openLocatorMenu(focusFirstItem = false): void {
    if (!locatorMenu || !locatorToggle || !locatorBrowser) return;
    locatorMenu.hidden = false;
    locatorToggle.setAttribute("aria-expanded", "true");
    locatorBrowser.classList.add("is-open");
    if (focusFirstItem) {
      locatorItems[0]?.focus();
    }
  }

  function closeLocatorMenu(): void {
    if (!locatorMenu || !locatorToggle || !locatorBrowser) return;
    locatorMenu.hidden = true;
    locatorToggle.setAttribute("aria-expanded", "false");
    locatorBrowser.classList.remove("is-open");
  }

  function initLocatorBrowser(): void {
    if (!locatorBrowser || !locatorToggle || !locatorMenu) return;

    locatorToggle.addEventListener("click", (e) => {
      const isKeyboard = e.detail === 0;
      const isExpanded = locatorToggle.getAttribute("aria-expanded") === "true";
      if (isExpanded) {
        closeLocatorMenu();
      } else {
        openLocatorMenu(isKeyboard);
      }
    });

    locatorToggle.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        openLocatorMenu(true);
      }
    });

    locatorItems.forEach((btn) => {
      btn.addEventListener("click", () => {
        const placeId = btn.dataset.placeId;
        if (placeId) {
          recordSelectionTrigger({
            modality: "pointer",
            origin: "locator_menu",
            returnTarget: locatorToggle,
          });
          selectionStore.set({ kind: "port", id: placeId });
          closeLocatorMenu();
          locatorToggle.focus();
        }
      });
    });

    locatorMenu.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        e.preventDefault();
        e.stopPropagation();
        closeLocatorMenu();
        locatorToggle.focus();
        return;
      }

      const activeIdx = locatorItems.indexOf(document.activeElement as HTMLButtonElement);

      if (e.key === "Enter" || e.key === " ") {
        const item = document.activeElement as HTMLButtonElement;
        if (locatorItems.includes(item)) {
          e.preventDefault();
          const placeId = item.dataset.placeId;
          if (placeId) {
            recordSelectionTrigger({
              modality: "keyboard",
              origin: "locator_menu",
              returnTarget: locatorToggle,
            });
            selectionStore.set({ kind: "port", id: placeId });
            closeLocatorMenu();
          }
        }
        return;
      }

      if (e.key === "ArrowDown") {
        e.preventDefault();
        const nextIdx = (activeIdx + 1) % locatorItems.length;
        locatorItems[nextIdx]?.focus();
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        const prevIdx = (activeIdx - 1 + locatorItems.length) % locatorItems.length;
        locatorItems[prevIdx]?.focus();
      } else if (e.key === "Home") {
        e.preventDefault();
        locatorItems[0]?.focus();
      } else if (e.key === "End") {
        e.preventDefault();
        locatorItems[locatorItems.length - 1]?.focus();
      }
    });

    window.addEventListener("click", (e) => {
      if (!locatorBrowser.contains(e.target as Node)) {
        closeLocatorMenu();
      }
    });
  }

  initMap();
</script>

<style>
  .map-viewport {
    position: relative;
    width: 100%;
    height: 100%;
    background: var(--cc-sea);
    overflow: hidden;
  }

  .map-viewport__canvas {
    width: 100%;
    height: 100%;
  }

  .map-viewport__canvas:focus-visible {
    outline: 2px solid var(--cc-atlantic);
    outline-offset: -2px;
  }

  .map-epistemic-legend {
    position: absolute;
    bottom: 1.25rem;
    left: 1.25rem;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.65rem;
    background: color-mix(in srgb, var(--cc-paper) 92%, transparent);
    border: 1px solid var(--cc-line);
    border-radius: var(--cc-radius-xs);
    backdrop-filter: blur(4px);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
    pointer-events: none;
  }

  .map-epistemic-legend__icon {
    font-family: var(--cc-font-mono);
    font-size: 0.9rem;
    color: var(--cc-sand);
    line-height: 1;
  }

  .map-epistemic-legend__text {
    font-family: var(--cc-font-sans);
    font-size: 0.68rem;
    color: var(--cc-ink-muted);
    letter-spacing: 0.01em;
  }

  .map-locator-browser {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 20;
    display: flex;
    flex-direction: column;
  }

  .map-locator-browser__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.75rem;
    background: var(--cc-paper-raised);
    border: 1px solid var(--cc-line);
    border-radius: var(--cc-radius-sm);
