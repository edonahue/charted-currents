---
import "maplibre-gl/dist/maplibre-gl.css";

// Server-side historical places for locator dropdown
const PLACES = [
  { id: "place_jamaica", label: "Jamaica", region: "Greater Antilles", precision: "Colony / Island reference" },
  { id: "place_port_royal", label: "Port Royal", region: "Jamaica", precision: "Harbor spit / Sourced 1684" },
  { id: "place_london", label: "London", region: "England", precision: "Port city" },
  { id: "place_dartmouth", label: "Dartmouth, Devon", region: "England", precision: "Capture roadstead" },
  { id: "place_plymouth", label: "Plymouth, Devon", region: "England", precision: "Capture roadstead" },
] as const;
---

<section class="map-viewport" aria-label="Greater Caribbean map" data-component="map-viewport">
  <div id="charted-currents-map" class="map-viewport__canvas" tabindex="0" aria-label="Interactive map canvas. Use arrow keys to pan, plus and minus to zoom."></div>

  <!-- Perceivable locator browser for keyboard, screen-reader, and quick place navigation -->
  <div class="map-locator-browser" data-locator-browser>
    <button
      type="button"
      class="map-locator-browser__toggle"
      aria-expanded="false"
      aria-controls="map-locator-menu"
      data-locator-toggle
    >
      <span class="map-locator-browser__icon" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="7" cy="7" r="5.5" />
          <circle cx="7" cy="7" r="2" fill="currentColor" />
        </svg>
      </span>
      <span>Browse places</span>
      <span class="map-locator-browser__count" aria-hidden="true">({PLACES.length})</span>
    </button>
    <nav
      id="map-locator-menu"
      class="map-locator-browser__menu"
      aria-label="Historical places and locators"
      data-locator-menu
      hidden
    >
      <div class="map-locator-browser__header">
        <p class="panel-kicker">Historical Places</p>
        <span class="map-locator-browser__caption">Sourced Corpus (1684–1705)</span>
      </div>
      <ul class="map-locator-browser__list">
        {PLACES.map((place) => (
          <li>
            <button
              type="button"
              class="map-locator-browser__item"
              data-place-id={place.id}
              data-selection-id={place.id}
            >
              <span class="map-locator-browser__item-label">{place.label}</span>
              <span class="map-locator-browser__item-region">{place.region}</span>
            </button>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <p class="map-viewport__status sr-only" data-map-status role="status" aria-live="polite"></p>
</section>

<script>
  import { Map, NavigationControl, setWorkerUrl } from "maplibre-gl";
  import workerUrl from "maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url";
  import type { PublishedPortFeatureCollection, PublishedRouteFeatureCollection, Selection } from "../../lib/domain/types";
  import { publishedDataUrl } from "../../lib/data/loadPublished";
  import { applyBasemapVisualPolicy } from "../../lib/map/applyVisualPolicy";
  import { INITIAL_MAP_STYLE_URL, INITIAL_MAP_VIEW, SELECTION_CAMERA } from "../../lib/map/config";
  import { recordSelectionTrigger } from "../../lib/map/interactionState";
  import { PROJECT_MARKER_VISUAL_POLICY } from "../../lib/map/visualPolicy";
  import { selectionStore } from "../../lib/state/selection";

  setWorkerUrl(workerUrl);

  const container = document.getElementById("charted-currents-map");
  const status = document.querySelector<HTMLElement>("[data-map-status]");
  const locatorBrowser = document.querySelector<HTMLElement>("[data-locator-browser]");
  const locatorToggle = document.querySelector<HTMLButtonElement>("[data-locator-toggle]");
  const locatorMenu = document.querySelector<HTMLElement>("[data-locator-menu]");
  const locatorItems = Array.from(document.querySelectorAll<HTMLButtonElement>(".map-locator-browser__item"));

  let map: Map | null = null;
  let previousSelectedFeatureId: string | null = null;
  let hoveredFeatureId: string | null = null;
  let portsData: PublishedPortFeatureCollection | null = null;
  let routesData: PublishedRouteFeatureCollection | null = null;

  async function ensureProjectLayers(m: Map): Promise<void> {
    if (m.getSource("historical-ports")) return;

    try {
      const [portsRes, routesRes] = await Promise.all([
        fetch(publishedDataUrl("ports")),
        fetch(publishedDataUrl("routes")),
      ]);

      if (!portsRes.ok || !routesRes.ok) return;

      portsData = await portsRes.json();
      routesData = await routesRes.json();

      // 1. Add Routes Source
      m.addSource("historical-routes", {
        type: "geojson",
        data: routesData!,
      });

      // Route Casing
      m.addLayer({
        id: "historical-routes-casing",
        type: "line",
        source: "historical-routes",
        layout: {
          "line-cap": "round",
          "line-join": "round",
        },
        paint: {
          "line-color": "#f8f3e9",
          "line-width": 4,
          "line-opacity": 0.85,
        },
      });

      // Route Dashed Line
      m.addLayer({
        id: "historical-routes-line",
        type: "line",
        source: "historical-routes",
        layout: {
          "line-cap": "round",
          "line-join": "round",
        },
        paint: {
          "line-color": "#243f48",
          "line-width": 2,
          "line-dasharray": [3, 2],
          "line-opacity": 0.85,
        },
      });

      // Route Hit Target
      m.addLayer({
        id: "historical-routes-hit-target",
        type: "line",
        source: "historical-routes",
        paint: {
          "line-width": 18,
          "line-color": "transparent",
          "line-opacity": 0,
        },
      });

      // 2. Add Ports Source
      m.addSource("historical-ports", {
        type: "geojson",
        data: portsData!,
      });

      // Concentric outer ring layer with selected and hover states
      m.addLayer({
        id: "historical-ports-outer-ring",
        type: "circle",
        source: "historical-ports",
        paint: {
          "circle-radius": [
            "case",
            ["boolean", ["feature-state", "selected"], false],
            PROJECT_MARKER_VISUAL_POLICY.selectedOuterRingRadiusPx,
            ["boolean", ["feature-state", "hover"], false],
            PROJECT_MARKER_VISUAL_POLICY.outerRingRadiusPx + 1,
            PROJECT_MARKER_VISUAL_POLICY.outerRingRadiusPx,
          ],
          "circle-color": "transparent",
          "circle-stroke-color": [
            "case",
            ["boolean", ["feature-state", "selected"], false],
            PROJECT_MARKER_VISUAL_POLICY.colors.ringSelected,
            PROJECT_MARKER_VISUAL_POLICY.colors.ring,
          ],
          "circle-stroke-width": [
            "case",
            ["boolean", ["feature-state", "selected"], false],
            PROJECT_MARKER_VISUAL_POLICY.selectedStrokeWidthPx,
            ["boolean", ["feature-state", "hover"], false],
            PROJECT_MARKER_VISUAL_POLICY.strokeWidthPx + 0.5,
            PROJECT_MARKER_VISUAL_POLICY.strokeWidthPx,
          ],
          "circle-stroke-opacity": [
            "case",
            ["boolean", ["feature-state", "selected"], false],
            1,
            ["boolean", ["feature-state", "hover"], false],
            0.95,
            0.75,
          ],
        },
      });

      // Solid core dot layer
      m.addLayer({
        id: "historical-ports-core",
        type: "circle",
        source: "historical-ports",
        paint: {
          "circle-radius": [
            "case",
            ["boolean", ["feature-state", "selected"], false],
            PROJECT_MARKER_VISUAL_POLICY.selectedRadiusPx,
            PROJECT_MARKER_VISUAL_POLICY.radiusPx,
          ],
          "circle-color": [
            "case",
            ["boolean", ["feature-state", "selected"], false],
            PROJECT_MARKER_VISUAL_POLICY.colors.coreSelected,
            PROJECT_MARKER_VISUAL_POLICY.colors.core,
          ],
          "circle-stroke-color": PROJECT_MARKER_VISUAL_POLICY.colors.halo,
          "circle-stroke-width": 1.5,
        },
      });

      // Clean label layer
      m.addLayer({
        id: "historical-ports-label",
        type: "symbol",
        source: "historical-ports",
        layout: {
          "text-field": ["get", "canonical_name"],
          "text-variable-anchor": ["top", "bottom", "right", "left"],
          "text-radial-offset": 0.9,
          "text-justify": "auto",
          "text-size": 12,
          "text-optional": true,
        },
        paint: {
          "text-color": PROJECT_MARKER_VISUAL_POLICY.colors.labelText,
          "text-halo-color": PROJECT_MARKER_VISUAL_POLICY.colors.labelHalo,
          "text-halo-width": 1.5,
          "text-opacity": 0.92,
        },
      });

      // Generous transparent hit-target layer
      m.addLayer({
        id: "historical-ports-hit-target",
        type: "circle",
        source: "historical-ports",
        paint: {
          "circle-radius": 24,
          "circle-color": "transparent",
          "circle-opacity": 0,
        },
      });

      // Pointer listeners for ports
      m.on("mouseenter", "historical-ports-hit-target", (e) => {
        m.getCanvas().style.cursor = "pointer";
        const feature = e.features?.[0];
        if (feature?.id) {
          hoveredFeatureId = String(feature.id);
          m.setFeatureState({ source: "historical-ports", id: hoveredFeatureId }, { hover: true });
        }
      });

      m.on("mouseleave", "historical-ports-hit-target", () => {
        m.getCanvas().style.cursor = "";
        if (hoveredFeatureId) {
          m.setFeatureState({ source: "historical-ports", id: hoveredFeatureId }, { hover: false });
          hoveredFeatureId = null;
        }
      });

      m.on("click", "historical-ports-hit-target", (e) => {
        const feature = e.features?.[0];
        if (feature && feature.properties?.id) {
          recordSelectionTrigger({
            modality: "pointer",
            origin: "map",
            returnTarget: container,
          });
          selectionStore.set({ kind: "port", id: String(feature.properties.id) });
        }
      });

      // Pointer listeners for routes
      m.on("mouseenter", "historical-routes-hit-target", () => {
        m.getCanvas().style.cursor = "pointer";
      });

      m.on("mouseleave", "historical-routes-hit-target", () => {
        m.getCanvas().style.cursor = "";
      });

      m.on("click", "historical-routes-hit-target", (e) => {
        const feature = e.features?.[0];
        if (feature && feature.properties?.vessel_id) {
          recordSelectionTrigger({
            modality: "pointer",
            origin: "map",
            returnTarget: container,
          });
          selectionStore.set({ kind: "ship", id: String(feature.properties.vessel_id) });
        }
      });

      syncMapToSelection(selectionStore.get());
    } catch (err) {
      console.error("Failed to load historical map data:", err);
    }
  }

  function syncMapToSelection(selection: Selection): void {
    if (!map || !map.getSource("historical-ports")) return;

    if (previousSelectedFeatureId) {
      map.setFeatureState(
        { source: "historical-ports", id: previousSelectedFeatureId },
        { selected: false },
      );
      previousSelectedFeatureId = null;
    }

    if (selection && selection.kind === "port") {
      const portFeature = portsData?.features.find((f) => f.properties.id === selection.id);
      if (portFeature) {
        previousSelectedFeatureId = portFeature.id;
        map.setFeatureState(
          { source: "historical-ports", id: portFeature.id },
          { selected: true },
        );

        const isDesktop = window.innerWidth >= 768;
        const isReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const padding = isDesktop
          ? { right: 380, top: 40, bottom: 40, left: 40 }
          : { bottom: 260, top: 40, left: 20, right: 20 };

        if (isReducedMotion) {
          map.jumpTo({ center: portFeature.geometry.coordinates, padding });
        } else {
          map.easeTo({
            center: portFeature.geometry.coordinates,
            padding,
            duration: SELECTION_CAMERA.durationMs,
          });
        }
      }
    } else if (selection && selection.kind === "ship") {
      const routeFeature = routesData?.features.find((f) => f.properties.vessel_id === selection.id);
      if (routeFeature) {
        const originCoord = routeFeature.geometry.coordinates[0];
        if (originCoord) {
          const isDesktop = window.innerWidth >= 768;
          const isReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          const padding = isDesktop
            ? { right: 380, top: 40, bottom: 40, left: 40 }
            : { bottom: 260, top: 40, left: 20, right: 20 };

          if (isReducedMotion) {
            map.jumpTo({ center: originCoord, padding });
          } else {
            map.easeTo({
              center: originCoord,
              padding,
              duration: SELECTION_CAMERA.durationMs,
            });
          }
        }
      }
    }

    // Synchronize active state in locator menu
    locatorItems.forEach((btn) => {
      const isSelected = btn.dataset.selectionId === selection?.id;
      btn.setAttribute("aria-current", isSelected ? "true" : "false");
    });
  }

  async function onMapReady(): Promise<void> {
    if (!map || !container || container.dataset.mapReady === "true") return;
    applyBasemapVisualPolicy(map);
    await ensureProjectLayers(map);
    container.dataset.mapReady = "true";
    if (status) {
      status.textContent = "Historical map ready.";
      status.classList.add("sr-only");
      status.classList.remove("map-viewport__status--error");
    }

    map.once("idle", () => {
      container.dataset.mapIdle = "true";
    });
  }

  if (container instanceof HTMLElement) {
    try {
      map = new Map({
        container,
        style: INITIAL_MAP_STYLE_URL,
        center: INITIAL_MAP_VIEW.center,
        zoom: INITIAL_MAP_VIEW.zoom,
        bearing: 0,
        pitch: 0,
        maxPitch: 0,
        dragRotate: false,
        pitchWithRotate: false,
        touchPitch: false,
      });

      map.addControl(new NavigationControl({ showCompass: false }), "top-right");
      map.touchZoomRotate.disableRotation();

      container.addEventListener(
        "keydown",
        (event) => {
          if (
            event instanceof KeyboardEvent &&
            event.shiftKey &&
            ["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"].includes(event.key)
          ) {
            event.preventDefault();
            event.stopPropagation();
          }
        },
        { capture: true },
      );

      if (map.isStyleLoaded()) {
        onMapReady();
      } else {
        map.once("style.load", onMapReady);
        map.once("load", onMapReady);
      }

      map.on("error", () => {
        if (container.dataset.mapReady !== "true" && status) {
          status.textContent =
            "The basemap is temporarily unavailable. Historical places remain browsable via Browse Places.";
          status.classList.remove("sr-only");
          status.classList.add("map-viewport__status--error");
        }
      });

      selectionStore.subscribe((selection) => {
        syncMapToSelection(selection);
      });
    } catch {
      if (status) {
        status.textContent =
          "The basemap is temporarily unavailable. Historical places remain browsable via Browse Places.";
        status.classList.remove("sr-only");
        status.classList.add("map-viewport__status--error");
      }
    }
  }

  // Locator Browser Controls (Dropdown disclosure)
  if (locatorToggle && locatorMenu) {
    const toggleMenu = (open?: boolean, focusFirstItem: boolean = false) => {
      const willOpen = open ?? locatorMenu.hidden;
      locatorMenu.hidden = !willOpen;
      locatorToggle.setAttribute("aria-expanded", willOpen ? "true" : "false");
      if (willOpen && focusFirstItem) {
        locatorItems[0]?.focus();
      }
    };

    locatorToggle.addEventListener("click", (e) => {
      toggleMenu(undefined, e.detail === 0);
    });

    locatorToggle.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        toggleMenu(true, true);
      }
    });

    locatorMenu.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        e.preventDefault();
        e.stopPropagation();
        toggleMenu(false);
        locatorToggle.focus();
        return;
      }

      const activeIdx = locatorItems.indexOf(document.activeElement as HTMLButtonElement);
      if (e.key === "Enter" || e.key === " ") {
        const item = document.activeElement as HTMLButtonElement;
        if (locatorItems.includes(item)) {
          e.preventDefault();
          const selectionId = item.dataset.selectionId;
          if (selectionId) {
            recordSelectionTrigger({
              modality: "keyboard",
              origin: "locator_menu",
              returnTarget: locatorToggle,
            });
            selectionStore.set({ kind: "port", id: selectionId });
            toggleMenu(false);
          }
        }
        return;
      }

      if (e.key === "ArrowDown") {
        e.preventDefault();
        const nextIdx = (activeIdx + 1) % locatorItems.length;
        locatorItems[nextIdx]?.focus();
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        const prevIdx = (activeIdx - 1 + locatorItems.length) % locatorItems.length;
        locatorItems[prevIdx]?.focus();
      } else if (e.key === "Home") {
        e.preventDefault();
        locatorItems[0]?.focus();
      } else if (e.key === "End") {
        e.preventDefault();
        locatorItems[locatorItems.length - 1]?.focus();
      }
    });

    document.addEventListener("click", (e) => {
      if (!locatorBrowser?.contains(e.target as Node)) {
        if (!locatorMenu.hidden) {
          toggleMenu(false);
        }
      }
    });

    locatorItems.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const selectionId = btn.dataset.selectionId;
        if (selectionId) {
          const isKeyboard = e.detail === 0;
          recordSelectionTrigger({
            modality: isKeyboard ? "keyboard" : "pointer",
            origin: "locator_menu",
            returnTarget: locatorToggle,
          });
          selectionStore.set({ kind: "port", id: selectionId });
          toggleMenu(false);
          if (!isKeyboard) {
            locatorToggle.focus();
          }
        }
      });
    });
  }
</script>
