---
import "maplibre-gl/dist/maplibre-gl.css";
---

<section class="map-viewport" aria-label="Greater Caribbean map" data-component="map-viewport">
  <div id="charted-currents-map" class="map-viewport__canvas"></div>
  <p class="map-viewport__status" data-map-status role="status" aria-live="polite">
    Modern basemap only. Historical records and routes are not loaded in this bootstrap shell.
  </p>
</section>

<script>
  import { Map, NavigationControl } from "maplibre-gl";
  import { INITIAL_MAP_STYLE_URL, INITIAL_MAP_VIEW } from "../../lib/map/config";

  const container = document.getElementById("charted-currents-map");
  const status = document.querySelector<HTMLElement>("[data-map-status]");

  if (container instanceof HTMLElement) {
    const map = new Map({
      container,
      style: INITIAL_MAP_STYLE_URL,
      center: INITIAL_MAP_VIEW.center,
      zoom: INITIAL_MAP_VIEW.zoom,
      attributionControl: true,
    });

    map.addControl(new NavigationControl({ showCompass: false }), "top-right");

    map.once("load", () => {
      container.dataset.mapReady = "true";
      if (status) {
        status.textContent =
          "Modern basemap ready. Historical records and routes are intentionally not loaded yet.";
      }
    });

    map.on("error", () => {
      if (container.dataset.mapReady !== "true" && status) {
        status.textContent =
          "The modern basemap is temporarily unavailable. Historical data has not been substituted or invented.";
      }
    });
  }
</script>
