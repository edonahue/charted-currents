---
/**
 * src/components/map/MapViewport.astro
 *
 * MapLibre map viewport with SSR-rendered place locators, selection hierarchy,
 * transatlantic fitBounds camera behavior, and epistemic route legend.
 */
import "maplibre-gl/dist/maplibre-gl.css";
import entitiesData from "../../../public/data/entities.json";

const PLACES = (entitiesData.places || []).map((p) => ({
  id: p.id,
  label: p.canonical_name,
  region: p.region,
  precision: p.geographic_precision.replace(/_/g, " "),
}));

const MOLL_VISUAL = (entitiesData.visuals || []).find((v) => v.id === "visual_moll_west_indies_1715");
const hasMollLayer = Boolean(
  MOLL_VISUAL?.rectified_asset_path &&
  Array.isArray(MOLL_VISUAL?.georeference?.coordinates) &&
  MOLL_VISUAL.georeference.coordinates.length === 4
);
---

<section class="map-viewport" aria-label="Greater Caribbean map" data-component="map-viewport">
  <div id="charted-currents-map" class="map-viewport__canvas"></div>
  <p class="map-viewport__unavailable" data-map-unavailable role="alert" hidden>Interactive map unavailable in this browser. Browse places or search the atlas to inspect records.</p>

  <div class="map-view-controls" role="group" aria-label="Map orientation views" data-map-view-controls>
    <button type="button" data-map-view="caribbean" disabled>Caribbean</button>
    <button type="button" data-map-view="atlantic" disabled>Atlantic</button>
    <button type="button" data-map-view="globe" aria-pressed="false" disabled>Globe</button>
    <button type="button" data-map-north aria-label="Reset map bearing and tilt to north up" title="North up" disabled>N ↑</button>
  </div>

  <!-- Epistemic map legend -->
  <aside class="map-epistemic-legend" aria-label="Map notation">
    <span class="map-epistemic-legend__icon" aria-hidden="true">┄</span>
    <span class="map-epistemic-legend__text">Dashed lines connect documented endpoints · Not observed sailing tracks</span>
  </aside>

  <!-- Perceivable locator browser for keyboard, screen-reader, and quick place navigation -->
  <div class="map-locator-browser" data-locator-browser>
    <button
      type="button"
      class="map-locator-browser__toggle"
      aria-expanded="false"
      aria-controls="map-locator-menu"
      data-locator-toggle
    >
      <span class="map-locator-browser__icon" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="7" cy="7" r="5.5" />
          <circle cx="7" cy="7" r="2" fill="currentColor" />
        </svg>
      </span>
      <span>Browse places</span>
      <span class="map-locator-browser__count" aria-hidden="true">({PLACES.length})</span>
    </button>
    <nav
      id="map-locator-menu"
      class="map-locator-browser__menu"
      aria-label="Historical places and locators"
      data-locator-menu
      hidden
    >
      <div class="map-locator-browser__header">
        <div class="map-locator-browser__header-top">
          <p class="panel-kicker">Historical Places</p>
          <span class="map-locator-browser__caption">Reviewed Corpus</span>
        </div>
        <div class="map-locator-browser__search-box">
          <svg class="map-locator-browser__search-icon" width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="6" cy="6" r="4.5" />
            <line x1="9.5" y1="9.5" x2="13" y2="13" />
          </svg>
          <input
            type="search"
            class="map-locator-browser__filter-input"
            data-locator-filter-input
            placeholder="Filter places or regions..."
            aria-label={`Filter ${PLACES.length} historical places by name or region`}
            autocomplete="off"
            spellcheck="false"
          />
        </div>
        <div class="map-locator-browser__meta-row">
          <span class="map-locator-browser__filter-count" data-locator-filter-count aria-live="polite">
            {PLACES.length} places
          </span>
        </div>
      </div>
      <ul class="map-locator-browser__list">
        {PLACES.map((place) => (
          <li data-place-item-wrap data-place-name={place.label.toLowerCase()} data-place-region={place.region.toLowerCase()}>
            <button
              type="button"
              class="map-locator-browser__item"
              data-place-id={place.id}
              data-selection-id={place.id}
            >
              <span class="map-locator-browser__item-label">{place.label}</span>
              <span class="map-locator-browser__item-region">{place.region}</span>
            </button>
          </li>
        ))}
        <li class="map-locator-browser__empty" data-locator-empty hidden>
          No places match "<span data-locator-empty-query></span>"
        </li>
      </ul>
    </nav>
  </div>

  <!-- Historical period map reference layer control (Packet 8) -->
  {hasMollLayer && (
    <div
      class="map-layer-control"
      data-layer-control
      data-rectified-url={`/${MOLL_VISUAL!.rectified_asset_path}`}
      data-coordinates={JSON.stringify(MOLL_VISUAL!.georeference!.coordinates)}
      data-source-id={MOLL_VISUAL!.source_id}
      data-assertion-ids={JSON.stringify(MOLL_VISUAL!.assertion_ids || [])}
    >
      <button
        type="button"
        class="map-layer-control__toggle"
        aria-expanded="false"
        aria-controls="map-layer-panel"
        data-layer-toggle
        disabled
        title="Toggle Herman Moll [1715?] reference map options"
      >
        <span class="map-layer-control__icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="2" y="2" width="10" height="10" rx="1" />
            <path d="M2 5.5h10M5.5 2v10" />
          </svg>
        </span>
        <span>Period Map</span>
        <span class="map-layer-control__badge" data-layer-state-badge aria-hidden="true">Off</span>
      </button>
      <div
        id="map-layer-panel"
        class="map-layer-control__panel"
        aria-label="Historical map reference layer options"
        data-layer-panel
        hidden
      >
        <div class="map-layer-control__header">
          <div>
            <p class="panel-kicker">Historical Reference</p>
            <p class="map-layer-control__title" title="Catalogued date [1715?] by Library of Congress">Herman Moll · [1715?]</p>
          </div>
          <button
            type="button"
            class="map-layer-control__close"
            aria-label="Close period map options"
            data-layer-panel-close
          >
            <svg aria-hidden="true" width="10" height="10" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M1 1l12 12M13 1L1 13" />
            </svg>
          </button>
        </div>

        <div class="map-layer-control__body">
          <div class="map-layer-control__comparison" role="group" aria-label="Compare modern context and registered chart">
            <button type="button" data-map-comparison="modern" aria-pressed="true">Modern</button>
            <button type="button" data-map-comparison="blend" aria-pressed="false">Blend</button>
            <button type="button" data-map-comparison="chart" aria-pressed="false">Registered chart</button>
          </div>
          <p class="map-layer-control__comparison-note">Compare at the same geographic view. Sourced endpoints remain above the chart.</p>
          <p class="map-layer-control__status sr-only" data-layer-status data-state="idle" role="status" aria-atomic="true"></p>
          <label class="map-layer-control__switch">
            <input
              type="checkbox"
              data-layer-visibility-checkbox
              aria-label="Show Herman Moll [1715?] reference map"
            />
            <span class="map-layer-control__switch-label">Show [1715?] reference map</span>
          </label>

          <div class="map-layer-control__slider-group" data-layer-slider-group hidden>
            <div class="map-layer-control__slider-header">
              <label for="map-layer-opacity-slider" class="map-layer-control__slider-label">Opacity</label>
              <span class="map-layer-control__opacity-val" data-layer-opacity-val aria-hidden="true">65%</span>
            </div>
            <input
              type="range"
              id="map-layer-opacity-slider"
              data-layer-opacity-slider
              min="10"
              max="100"
              value="65"
              step="5"
              aria-label="[1715?] map layer opacity"
              aria-valuemin="10"
              aria-valuemax="100"
              aria-valuenow="65"
            />
          </div>

          <p class="map-layer-control__epistemic-note">
            18th-century chart aligned to modern coordinates via affine transformation. Not observed ground truth.
          </p>

          <button
            type="button"
            class="map-layer-control__inspect-btn"
            data-layer-inspect-btn
          >
            Inspect Source &amp; Provenance
          </button>
        </div>
      </div>
    </div>
  )}

  <p class="map-viewport__status sr-only" data-map-status role="status" aria-live="polite"></p>
</section>

<script>
  import { AttributionControl, Map, NavigationControl, setWorkerUrl, type ImageSource } from "maplibre-gl";
  import workerUrl from "maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url";
  import type { PublishedPortFeatureCollection, PublishedRouteFeatureCollection, Selection } from "../../lib/domain/types";
  import { loadPublishedPorts, loadPublishedRoutes } from "../../lib/data/loadPublished";
  import { transformBasemapStyle } from "../../lib/map/applyVisualPolicy";
  import { syncCoordinateGrid } from "../../lib/map/graticule";
  import { INITIAL_MAP_STYLE_URL, INITIAL_MAP_VIEW, MAP_VIEWS, globeOrientationZoom } from "../../lib/map/config";
  import { revealSelection, selectionCoordinates, visibleMapPadding } from "../../lib/map/cameraPolicy";
  import { readGeographicView, startViewNavigation } from "../../lib/map/viewNavigation";
  import { recordSelectionTrigger } from "../../lib/map/interactionState";
  import { BASEMAP_WATER_LABEL_LAYER_ID, PROJECT_MARKER_VISUAL_POLICY } from "../../lib/map/visualPolicy";
  import { selectionStore } from "../../lib/state/selection";
  import { timeFilterStore, type TimeFilterState } from "../../lib/state/timeFilter";

  setWorkerUrl(workerUrl);

  const container = document.getElementById("charted-currents-map");
  const status = document.querySelector<HTMLElement>("[data-map-status]");
  const locatorBrowser = document.querySelector<HTMLElement>("[data-locator-browser]");
  const locatorToggle = document.querySelector<HTMLButtonElement>("[data-locator-toggle]");
  const locatorMenu = document.querySelector<HTMLElement>("[data-locator-menu]");
  const locatorItems = Array.from(document.querySelectorAll<HTMLButtonElement>(".map-locator-browser__item"));
  const locatorFilterInput = document.querySelector<HTMLInputElement>("[data-locator-filter-input]");
  const locatorFilterCount = document.querySelector<HTMLElement>("[data-locator-filter-count]");
  const locatorEmptyState = document.querySelector<HTMLElement>("[data-locator-empty]");
  const locatorEmptyQuery = document.querySelector<HTMLElement>("[data-locator-empty-query]");
  const locatorItemWraps = Array.from(document.querySelectorAll<HTMLElement>("[data-place-item-wrap]"));

  const layerControl = document.querySelector<HTMLElement>("[data-layer-control]");
  const layerToggle = document.querySelector<HTMLButtonElement>("[data-layer-toggle]");
  const layerPanel = document.querySelector<HTMLElement>("[data-layer-panel]");
  const layerPanelClose = document.querySelector<HTMLButtonElement>("[data-layer-panel-close]");
  const layerBadge = document.querySelector<HTMLElement>("[data-layer-state-badge]");
  const layerStatus = document.querySelector<HTMLElement>("[data-layer-status]");
  const visibilityCheckbox = document.querySelector<HTMLInputElement>("[data-layer-visibility-checkbox]");
  const sliderGroup = document.querySelector<HTMLElement>("[data-layer-slider-group]");
  const opacitySlider = document.querySelector<HTMLInputElement>("[data-layer-opacity-slider]");
  const opacityVal = document.querySelector<HTMLElement>("[data-layer-opacity-val]");
  const inspectBtn = document.querySelector<HTMLButtonElement>("[data-layer-inspect-btn]");

  const lifecycle = new AbortController();
  const subscriptions: (() => void)[] = [];
  let resizeObserver: ResizeObserver | null = null;
  let inspectorObserver: MutationObserver | null = null;
  let cameraTimer: ReturnType<typeof setTimeout> | undefined;
  let chromeFrame = 0;
  let cameraSuppressed = false;
  let globeAvailable = true;
  let viewNavigation: ReturnType<typeof startViewNavigation> | null = null;
  let blendOpacity = 65;
  let periodMapState: "idle" | "loading" | "ready" | "error" = "idle";
  const periodMapSource = "historical-reference-moll-1715";
  const periodMapLayer = `${periodMapSource}-layer`;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  function setMapControlsEnabled(enabled: boolean): void {
    document.querySelectorAll<HTMLButtonElement>("[data-map-view], [data-map-north], [data-layer-toggle], .maplibregl-ctrl-zoom-in, .maplibregl-ctrl-zoom-out")
      .forEach((button) => { button.disabled = !enabled || (button.dataset.mapView === "globe" && !globeAvailable); });
  }

  function showUnavailableMap(message: string): void {
    const notice = document.querySelector<HTMLElement>("[data-map-unavailable]");
    if (notice) { notice.textContent = message; notice.hidden = false; }
    if (status) status.textContent = message;
    setMapControlsEnabled(false);
  }

  function listen<T extends keyof GlobalEventHandlersEventMap>(target: EventTarget | null, type: T,
    callback: (event: GlobalEventHandlersEventMap[T]) => void, options: AddEventListenerOptions = {}): void {
    target?.addEventListener(type, callback as EventListener, { ...options, signal: lifecycle.signal });
  }

  function cancelCamera(): void {
    cameraSuppressed = true;
    clearTimeout(cameraTimer);
    map?.stop();
  }

  function layoutMapChrome(): void {
    if (!container) return;
    cancelAnimationFrame(chromeFrame);
    const inspector = document.getElementById("entity-inspector");
    const bounds = container.getBoundingClientRect();
    const sheet = inspector && !inspector.hidden && window.innerWidth <= 1024
      ? inspector.getBoundingClientRect() : null;
    const overlap = sheet ? Math.max(0, bounds.bottom - Math.max(bounds.top, sheet.top)) : 0;
    container.parentElement?.style.setProperty("--cc-map-sheet-overlap", `${overlap}px`);
    // Each position depends on the preceding custom property. ResizeObserver
    // reports dimension changes, so reading the old position in the same
    // callback can otherwise leave controls stranded after a sheet closes.
    // Two bounded layout frames settle the stack; there is no idle loop.
    chromeFrame = requestAnimationFrame(() => {
      if (lifecycle.signal.aborted || !container) return;
      const attribution = container.querySelector<HTMLElement>(".maplibregl-ctrl-attrib");
      const attributionRect = attribution?.getBoundingClientRect();
      const clearance = attributionRect?.height
        ? Math.max(32, container.getBoundingClientRect().bottom - attributionRect.top + 12)
        : overlap + 40;
      container.parentElement?.style.setProperty("--cc-map-attribution-clearance", `${clearance}px`);
      chromeFrame = requestAnimationFrame(() => {
        chromeFrame = 0;
        if (lifecycle.signal.aborted || !container) return;
        const legendRect = document.querySelector<HTMLElement>(".map-epistemic-legend")?.getBoundingClientRect();
        const legendClearance = legendRect?.height
          ? container.getBoundingClientRect().bottom - legendRect.top + 12 : clearance + 42;
        container.parentElement?.style.setProperty("--cc-map-legend-clearance", `${legendClearance}px`);
      });
    });
  }

  function scheduleSelectionCamera(): void {
    clearTimeout(cameraTimer);
    if (cameraSuppressed || lifecycle.signal.aborted) return;
    // Wait for the inspector's actual layout, including compact sheet motion.
    cameraTimer = setTimeout(() => {
      if (!map || !container || cameraSuppressed || lifecycle.signal.aborted) return;
      const inspector = document.getElementById("entity-inspector");
      const inspectorRect = inspector && !inspector.hidden ? inspector.getBoundingClientRect() : null;
      revealSelection(map, selectionCoordinates(selectionStore.get(), portsData, routesData),
        visibleMapPadding(container.getBoundingClientRect(), inspectorRect), reducedMotion.matches);
    }, reducedMotion.matches ? 0 : 240);
  }

  let map: Map | null = null;
  let previousSelectedFeatureId: string | null = null;
  let hoveredFeatureId: string | null = null;
  let portsData: PublishedPortFeatureCollection | null = null;
  let routesData: PublishedRouteFeatureCollection | null = null;
  let activeTimeFilter: TimeFilterState = timeFilterStore.get();

  async function initMap() {
    if (!container) return;

    // The corpus browser remains useful even if no WebGL context can be made.
    initLocatorBrowser();
    window.addEventListener("pagehide", (event) => {
      if (event.persisted) cancelCamera();
      else cleanupMap();
    }, { signal: lifecycle.signal });
    document.addEventListener("astro:before-swap", cleanupMap, { signal: lifecycle.signal });

    try {
      const requestedUrl = new URL(window.location.href);
      const requestedView = readGeographicView(requestedUrl);
      const initialView = requestedView ?? INITIAL_MAP_VIEW;
      const bounds = container.getBoundingClientRect();
      const initialZoom = requestedView?.mode === "globe" && !requestedUrl.searchParams.has("view")
        ? globeOrientationZoom(bounds.width, bounds.height)
        : initialView.zoom;
      map = new Map({
        container,
        center: initialView.center,
        zoom: initialZoom,
        minZoom: 0.7,
        maxZoom: 9,
        bearing: 0,
        pitch: 0,
        dragRotate: false,
        pitchWithRotate: false,
        touchPitch: false,
        attributionControl: false,
      });
      // MapLibre can return from its constructor after a GPU initialization
      // error instead of throwing. Confirm the existing canvas context before
      // wiring a map that can never reach its load event.
      if (!map.getCanvas().getContext("webgl2")) {
        try { map.remove(); } catch { /* Partially initialized map. */ }
        map = null;
        throw new Error("WebGL2 context unavailable");
      }
      // Fetch the small reviewed geometry alongside the basemap, not after its
      // load event. Share the same session requests with later record inspection.
      const geometry = Promise.all([loadPublishedPorts(), loadPublishedRoutes()]);
      void geometry.catch(() => {}); // The load handler reports any failure.
      // Keep north-up navigation while retaining arrow-key pan and pinch zoom.
      map.keyboard.disableRotation();
      map.touchZoomRotate.disableRotation();
      map.getCanvas().setAttribute("aria-label", "Interactive map canvas. Use arrow keys to pan, plus and minus to zoom.");
      map.on("error", () => {
        // Remote style/resource failures arrive asynchronously, outside the
        // constructor catch. Keep the published corpus available without WebGL.
        if (lifecycle.signal.aborted || container.dataset.mapReady === "true") return;
        showUnavailableMap("The map background could not be loaded. Browse places or search the atlas to inspect records.");
      });

      if (import.meta.env.DEV || (typeof window !== "undefined" && Boolean((window as any).__ENABLE_MAP_TEST_HARNESS__))) {
        (window as any).__CC_MAP__ = map;
      }

      map.addControl(
        new AttributionControl({
          compact: true,
        }),
        "bottom-right"
      );

      map.addControl(
        new NavigationControl({
          showCompass: false,
          showZoom: true,
          visualizePitch: false,
        }),
        "bottom-right"
      );
      setMapControlsEnabled(false);

      map.once("style.load", () => {
        if (!map || lifecycle.signal.aborted) return;
        const readyMap = map;
        viewNavigation = startViewNavigation(readyMap, { cancelSelectionCamera: cancelCamera, onMode: applyDisplayMode });
        const syncGrid = () => syncCoordinateGrid(readyMap, periodMapVisible());
        syncGrid();
        readyMap.on("moveend", syncGrid);
        subscriptions.push(() => readyMap.off("moveend", syncGrid));
        void loadHistoricalData(readyMap, geometry);
      });

      map.once("load", () => {
        if (!map || !container) return;
        container.dataset.mapReady = "true";
        document.querySelector<HTMLElement>("[data-map-unavailable]")?.setAttribute("hidden", "");
        setMapControlsEnabled(true);
      });

      map.on("idle", () => {
        if (!container) return;
        container.dataset.mapIdle = "true";
      });

      subscriptions.push(selectionStore.subscribe((selection) => {
        viewNavigation?.selectionChanged();
        cancelCamera();
        cameraSuppressed = false;
        syncMapToSelection(selection);
      }));

      for (const event of ["pointerdown", "wheel", "touchstart", "keydown"] as const) {
        listen(container, event, () => { cancelCamera(); viewNavigation?.userInput(); }, { capture: true, passive: true });
      }
      const inspector = document.getElementById("entity-inspector");
      resizeObserver = new ResizeObserver(() => {
        // MapLibre already resizes its canvas when this container changes size.
        // Attribution and sheet changes only need layout measurements here.
        layoutMapChrome();
        scheduleSelectionCamera();
      });
      resizeObserver.observe(container);
      const attribution = container.querySelector<HTMLElement>(".maplibregl-ctrl-attrib");
      const legend = document.querySelector<HTMLElement>(".map-epistemic-legend");
      if (attribution) resizeObserver.observe(attribution);
      if (legend) resizeObserver.observe(legend);
      if (inspector) {
        resizeObserver.observe(inspector);
        inspectorObserver = new MutationObserver(() => { layoutMapChrome(); scheduleSelectionCamera(); });
        inspectorObserver.observe(inspector, { attributes: true, attributeFilter: ["hidden", "data-sheet-state"] });
      }
      initViewControls();
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) cancelCamera();
      }, { signal: lifecycle.signal });
      reducedMotion.addEventListener("change", () => {
        if (reducedMotion.matches) cancelCamera();
      }, { signal: lifecycle.signal });

      initLayerControl(map);
      map.setStyle(INITIAL_MAP_STYLE_URL, {
        transformStyle: (previous, seed) => {
          const style = transformBasemapStyle(previous, seed);
          // Restore Globe through applyDisplayMode after style load so a failed
          // projection can recover to the initialized 2D map.
          return { ...style, projection: { type: "mercator" } };
        },
      });
    } catch (err) {
      console.error("Map initialization failed:", err);
      showUnavailableMap("Interactive map unavailable in this browser. Browse places or search the atlas to inspect records.");
    }
  }

  async function loadHistoricalData(m: Map, geometry: Promise<[PublishedPortFeatureCollection, PublishedRouteFeatureCollection]>) {
    try {
      const [ports, routes] = await geometry;
      if (lifecycle.signal.aborted || map !== m) return;
      portsData = ports;
      routesData = routes;

      // 1. Add Routes Source
      m.addSource("historical-routes", {
        type: "geojson",
        data: routesData!,
      });

      // Render schematic dashed line
      m.addLayer({
        id: "historical-routes-line",
        type: "line",
        source: "historical-routes",
        paint: {
          "line-color": "#694d38",
          "line-width": 1.3,
          "line-opacity": 0.34,
          "line-dasharray": [2.4, 2.1],
        },
      });

      // Hit-target layer for routes
      m.addLayer({
        id: "historical-routes-hit-target",
        type: "line",
        source: "historical-routes",
        paint: {
          "line-width": 18,
          "line-color": "transparent",
          "line-opacity": 0,
        },
      });

      // 2. Add Ports Source
      m.addSource("historical-ports", {
        type: "geojson",
        data: portsData!,
      });

      // Concentric outer ring layer
      m.addLayer({
        id: "historical-ports-outer-ring",
        type: "circle",
        source: "historical-ports",
        paint: {
          "circle-radius": [
            "interpolate", ["linear"], ["zoom"],
            1, ["case", ["boolean", ["feature-state", "selected"], false], 8,
              ["boolean", ["feature-state", "hover"], false], 5, 3.5],
            6, ["case", ["boolean", ["feature-state", "selected"], false], PROJECT_MARKER_VISUAL_POLICY.selectedOuterRingRadiusPx,
              ["boolean", ["feature-state", "hover"], false], PROJECT_MARKER_VISUAL_POLICY.outerRingRadiusPx + 1, PROJECT_MARKER_VISUAL_POLICY.outerRingRadiusPx],
          ],
          "circle-color": "transparent",
          "circle-stroke-color": [
            "case",
            ["boolean", ["feature-state", "selected"], false],
            PROJECT_MARKER_VISUAL_POLICY.colors.ringSelected,
            PROJECT_MARKER_VISUAL_POLICY.colors.ring,
          ],
          "circle-stroke-width": [
            "case",
            ["boolean", ["feature-state", "selected"], false],
            PROJECT_MARKER_VISUAL_POLICY.selectedStrokeWidthPx,
            ["boolean", ["feature-state", "hover"], false],
            PROJECT_MARKER_VISUAL_POLICY.strokeWidthPx + 0.5,
            PROJECT_MARKER_VISUAL_POLICY.strokeWidthPx,
          ],
          "circle-stroke-opacity": [
            "case",
            ["boolean", ["feature-state", "selected"], false],
            1,
            ["boolean", ["feature-state", "hover"], false],
            0.95,
            0.75,
          ],
        },
      });

      // Solid core dot layer
      m.addLayer({
        id: "historical-ports-core",
        type: "circle",
        source: "historical-ports",
        paint: {
          "circle-radius": [
            "interpolate", ["linear"], ["zoom"],
            1, ["case", ["boolean", ["feature-state", "selected"], false], 3.5, 2],
            6, ["case", ["boolean", ["feature-state", "selected"], false], PROJECT_MARKER_VISUAL_POLICY.selectedRadiusPx, PROJECT_MARKER_VISUAL_POLICY.radiusPx],
          ],
          "circle-color": [
            "case",
            ["boolean", ["feature-state", "selected"], false],
            PROJECT_MARKER_VISUAL_POLICY.colors.coreSelected,
            PROJECT_MARKER_VISUAL_POLICY.colors.core,
          ],
          "circle-stroke-color": PROJECT_MARKER_VISUAL_POLICY.colors.halo,
          "circle-stroke-width": 1.5,
        },
      });

      // Clean label layer
      m.addLayer({
        id: "historical-ports-label",
        type: "symbol",
        source: "historical-ports",
        layout: {
          "text-field": ["get", "canonical_name"],
          "text-font": ["Noto Sans Regular"],
          "text-variable-anchor": ["top", "bottom", "right", "left"],
          "text-radial-offset": 0.9,
          "text-justify": "auto",
          "text-size": ["interpolate", ["linear"], ["zoom"], 1, 10, 4, 11.5, 6, 12],
          "text-padding": 5,
          "text-optional": true,
        },
        paint: {
          "text-color": PROJECT_MARKER_VISUAL_POLICY.colors.labelText,
          "text-halo-color": PROJECT_MARKER_VISUAL_POLICY.colors.labelHalo,
          "text-halo-width": 1.5,
          "text-opacity": 0.92,
        },
      });

      // Hit-target layer for ports
      m.addLayer({
        id: "historical-ports-hit-target",
        type: "circle",
        source: "historical-ports",
        paint: {
          "circle-radius": 24,
          "circle-color": "transparent",
          "circle-opacity": 0,
        },
      });

      // Pointer listeners for ports
      m.on("mouseenter", "historical-ports-hit-target", (e) => {
        m.getCanvas().style.cursor = "pointer";
        const feature = e.features?.[0];
        if (feature?.id) {
          hoveredFeatureId = String(feature.id);
          m.setFeatureState({ source: "historical-ports", id: hoveredFeatureId }, { hover: true });
        }
      });

      m.on("mouseleave", "historical-ports-hit-target", () => {
        m.getCanvas().style.cursor = "";
        if (hoveredFeatureId) {
          m.setFeatureState({ source: "historical-ports", id: hoveredFeatureId }, { hover: false });
          hoveredFeatureId = null;
        }
      });

      m.on("click", "historical-ports-hit-target", (e) => {
        const feature = e.features?.[0];
        if (feature && feature.properties?.id) {
          recordSelectionTrigger({
            modality: "pointer",
            origin: "map",
            returnTarget: m.getCanvas(),
          });
          selectionStore.set({ kind: "port", id: String(feature.properties.id) });
        }
      });

      // Pointer listeners for routes
      m.on("mouseenter", "historical-routes-hit-target", () => {
        m.getCanvas().style.cursor = "pointer";
      });

      m.on("mouseleave", "historical-routes-hit-target", () => {
        m.getCanvas().style.cursor = "";
      });

      m.on("click", "historical-routes-hit-target", (e) => {
        // Ports sit above endpoint connectors. One pointer action must not
        // select a port and then immediately replace it with the route below.
        if (m.queryRenderedFeatures(e.point, { layers: ["historical-ports-hit-target"] }).length) return;
        const feature = e.features?.[0];
        if (!feature || !feature.properties) return;
        const props = feature.properties;
        const recCount = Number(props.record_count) || 1;
        recordSelectionTrigger({
          modality: "pointer",
          origin: "map",
          returnTarget: m.getCanvas(),
        });
        if (recCount > 1) {
          selectionStore.set({ kind: "voyage", id: String(props.route_group_id || props.id) });
        } else {
          // Display edges carry reviewed constituent IDs, not a vessel_id.
          // MapLibre can serialize GeoJSON array properties into JSON strings.
          let constituents: unknown = props.constituent_vessel_ids;
          if (typeof constituents === "string") {
            try { constituents = JSON.parse(constituents); } catch { constituents = null; }
          }
          const vesselIds = Array.isArray(constituents)
            ? [...new Set(constituents.filter((id): id is string => typeof id === "string" && Boolean(id)))]
            : [];
          if (vesselIds.length === 1) selectionStore.set({ kind: "ship", id: vesselIds[0] });
          else if (props.route_group_id || props.id) {
            // Keep an ambiguous connection at route level rather than choosing
            // one vessel or manufacturing an identity from a display label.
            selectionStore.set({ kind: "voyage", id: String(props.route_group_id || props.id) });
          }
        }
      });

      subscriptions.push(timeFilterStore.subscribe((filter) => {
        activeTimeFilter = filter;
        updateRouteVisualHierarchy(selectionStore.get(), activeTimeFilter);
      }));

      syncMapToSelection(selectionStore.get());
    } catch (err) {
      if (lifecycle.signal.aborted) return;
      console.error("Failed to load historical map data:", err);
    }
  }

  function periodMapVisible(): boolean {
    return periodMapState === "ready" && Boolean(visibilityCheckbox?.checked);
  }

  function updateRouteVisualHierarchy(selection: Selection, timeFilter: TimeFilterState): void {
    if (!map || !map.getLayer("historical-routes-line")) return;

    const filterActive = timeFilter.id !== "all";
    const startY = timeFilter.startYear;
    const endY = timeFilter.endYear;

    // Helper condition: is route or any constituent member inside active temporal filter?
    const inTimeCondition: any = filterActive
      ? [
          "any",
          ...Array.from({ length: endY - startY + 1 }, (_, i) => [
            "in",
            startY + i,
            ["get", "member_years"],
          ]),
          [
            "all",
            [">=", ["get", "associated_record_year"], startY],
            ["<=", ["get", "associated_record_year"], endY],
          ],
        ]
      : true;

    if (selection && selection.kind === "port") {
      const isConnectedToPort: any = [
        "any",
        ["==", ["get", "origin_place_id"], selection.id],
        ["==", ["get", "destination_place_id"], selection.id],
      ];

      map.setPaintProperty("historical-routes-line", "line-opacity", [
        "case",
        ["all", isConnectedToPort, inTimeCondition],
        0.95,
        isConnectedToPort,
        0.16, // Connected but out-of-period remains visibly dimmed
        inTimeCondition,
        0.12,
        0.02,
      ]);
      map.setPaintProperty("historical-routes-line", "line-width", [
        "case",
        ["all", isConnectedToPort, inTimeCondition],
        2.4,
        isConnectedToPort,
        1.6,
        1.4,
      ]);
      map.setPaintProperty("historical-routes-line", "line-color", "#694d38");
    } else if (selection && selection.kind === "ship") {
      const isSelectedShip: any = [
        "in",
        selection.id,
        ["get", "constituent_vessel_ids"],
      ];

      map.setPaintProperty("historical-routes-line", "line-opacity", [
        "case",
        ["all", isSelectedShip, inTimeCondition],
        1.0,
        isSelectedShip,
        0.25, // Selected ship but out-of-period
        inTimeCondition,
        0.12,
        0.02,
      ]);
      map.setPaintProperty("historical-routes-line", "line-width", [
        "case",
        isSelectedShip,
        2.8,
        1.4,
      ]);
      map.setPaintProperty("historical-routes-line", "line-color", [
        "case",
        isSelectedShip,
        "#c85a32",
        "#694d38",
      ]);
    } else if (selection && selection.kind === "voyage") {
      const isSelectedGroup: any = [
        "any",
        ["==", ["get", "route_group_id"], selection.id],
        ["==", ["get", "id"], selection.id],
      ];

      map.setPaintProperty("historical-routes-line", "line-opacity", [
        "case",
        ["all", isSelectedGroup, inTimeCondition],
        1.0,
        isSelectedGroup,
        0.25,
        inTimeCondition,
        0.12,
        0.02,
      ]);
      map.setPaintProperty("historical-routes-line", "line-width", [
        "case",
        isSelectedGroup,
        2.8,
        1.4,
      ]);
      map.setPaintProperty("historical-routes-line", "line-color", [
        "case",
        isSelectedGroup,
        "#c85a32",
        "#694d38",
      ]);
    } else {
      // Default: no selection
      map.setPaintProperty("historical-routes-line", "line-opacity", [
        "case",
        inTimeCondition,
        0.34,
        0.04,
      ]);
      map.setPaintProperty("historical-routes-line", "line-width", [
        "case",
        inTimeCondition,
        1.3,
        1.2,
      ]);
      map.setPaintProperty("historical-routes-line", "line-color", "#694d38");
    }
  }

  function syncMapToSelection(selection: Selection): void {
    if (!map || !map.getSource("historical-ports")) return;

    if (previousSelectedFeatureId) {
      map.setFeatureState(
        { source: "historical-ports", id: previousSelectedFeatureId },
        { selected: false }
      );
      previousSelectedFeatureId = null;
    }

    if (selection?.kind === "port") {
      const port = portsData?.features.find((feature) => feature.properties.id === selection.id);
      if (port) {
        previousSelectedFeatureId = port.id;
        map.setFeatureState({ source: "historical-ports", id: port.id }, { selected: true });
      }
    }
    scheduleSelectionCamera();

    updateRouteVisualHierarchy(selection, activeTimeFilter);
  }

  function applyDisplayMode(mode: "mercator" | "globe"): "mercator" | "globe" {
    if (!map || (mode === "globe" && !globeAvailable)) return "mercator";
    let effectiveMode = mode;
    try {
      map.setProjection({ type: mode });
      map.setSky({ "sky-color": "#dce9e7", "horizon-color": "#d8eeed", "fog-color": "#d8eeed",
        "atmosphere-blend": mode === "globe" ? 0.65 : 0 });
    } catch (error) {
      if (mode !== "globe") throw error;
      globeAvailable = false;
      effectiveMode = "mercator";
      map.setProjection({ type: "mercator" });
      const globeButton = document.querySelector<HTMLButtonElement>('[data-map-view="globe"]');
      if (globeButton) {
        globeButton.disabled = true;
        globeButton.title = "Globe unavailable in this browser. The 2D atlas remains available.";
      }
      if (status) status.textContent = "Globe unavailable in this browser. The 2D atlas remains available.";
    }
    document.querySelector('[data-map-view="globe"]')?.setAttribute("aria-pressed", String(effectiveMode === "globe"));
    if (container?.parentElement) container.parentElement.dataset.mapProjection = effectiveMode;
    return effectiveMode;
  }

  function initViewControls(): void {
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-map-view]"));
    buttons.forEach((button) => listen(button, "click", () => {
      if (!map) return;
      const key = button.dataset.mapView as keyof typeof MAP_VIEWS;
      const view = MAP_VIEWS[key];
      if (!view || container?.dataset.mapReady !== "true") return;
      cancelCamera();
      const mode = applyDisplayMode(view.projection);
      const target = mode === view.projection ? view : MAP_VIEWS.caribbean;
      viewNavigation?.explicitView();
      const rect = map.getContainer().getBoundingClientRect();
      const zoom = key === "globe" && mode === "globe" ? globeOrientationZoom(rect.width, rect.height) : target.zoom;
      // Explicit view changes are direct orientation commands, not selection travel.
      map.easeTo({ center: target.center, zoom, bearing: 0, pitch: 0,
        padding: { top: 0, bottom: 0, left: 0, right: 0 }, duration: reducedMotion.matches ? 0 : 650 });
      if (status && mode === view.projection) status.textContent = `${button.textContent} view. Modern basemap for orientation.`;
    }));
    listen(document.querySelector("[data-map-north]"), "click", () => {
      cancelCamera();
      map?.easeTo({ bearing: 0, pitch: 0, duration: reducedMotion.matches ? 0 : 300 });
      if (status) status.textContent = "Map reset to north up.";
    });
  }

  function cleanupMap(): void {
    clearTimeout(cameraTimer);
    cancelAnimationFrame(chromeFrame);
    lifecycle.abort();
    subscriptions.splice(0).forEach((unsubscribe) => unsubscribe());
    viewNavigation?.dispose();
    resizeObserver?.disconnect();
    inspectorObserver?.disconnect();
    map?.remove();
    map = null;
    if (container) delete container.dataset.mapReady;
    if (import.meta.env.DEV || (window as any).__ENABLE_MAP_TEST_HARNESS__) delete (window as any).__CC_MAP__;
  }

  function getVisibleLocatorButtons(): HTMLButtonElement[] {
    return locatorItemWraps
      .filter((wrap) => !wrap.hidden)
      .map((wrap) => wrap.querySelector<HTMLButtonElement>(".map-locator-browser__item"))
      .filter((btn): btn is HTMLButtonElement => btn !== null);
  }

  function applyPlaceFilter(rawQuery: string): void {
    const q = rawQuery.trim().toLowerCase();
    let visibleCount = 0;
    for (const wrap of locatorItemWraps) {
      const name = wrap.dataset.placeName || "";
      const region = wrap.dataset.placeRegion || "";
      const matches = !q || name.includes(q) || region.includes(q);
      wrap.hidden = !matches;
      if (matches) visibleCount++;
    }

    if (locatorFilterCount) {
      if (!q) {
        locatorFilterCount.textContent = `${locatorItemWraps.length} places`;
      } else {
        locatorFilterCount.textContent = `${visibleCount} of ${locatorItemWraps.length} places`;
      }
    }

    if (locatorEmptyState) {
      if (visibleCount === 0 && q) {
        locatorEmptyState.hidden = false;
        if (locatorEmptyQuery) locatorEmptyQuery.textContent = rawQuery.trim();
      } else {
        locatorEmptyState.hidden = true;
      }
    }
  }

  function openLocatorMenu(focusFirstItem = false): void {
    if (!locatorMenu || !locatorToggle || !locatorBrowser) return;
    closeLayerPanel();
    locatorMenu.hidden = false;
    locatorToggle.setAttribute("aria-expanded", "true");
    locatorBrowser.classList.add("is-open");
    if (focusFirstItem) {
      if (locatorFilterInput) {
        locatorFilterInput.focus();
      } else {
        locatorItems[0]?.focus();
      }
    }
  }

  function closeLocatorMenu(): void {
    if (!locatorMenu || !locatorToggle || !locatorBrowser) return;
    locatorMenu.hidden = true;
    locatorToggle.setAttribute("aria-expanded", "false");
    locatorBrowser.classList.remove("is-open");
    if (locatorFilterInput && locatorFilterInput.value) {
      locatorFilterInput.value = "";
      applyPlaceFilter("");
    }
  }

  function openLayerPanel(): void {
    if (!layerPanel || !layerToggle) return;
    closeLocatorMenu();
    layerPanel.removeAttribute("hidden");
    layerToggle.setAttribute("aria-expanded", "true");
    visibilityCheckbox?.focus();
  }

  function closeLayerPanel(): void {
    if (!layerPanel || !layerToggle) return;
    layerPanel.setAttribute("hidden", "");
    layerToggle.setAttribute("aria-expanded", "false");
  }

  function initLayerControl(m: Map): void {
    if (!layerControl || !layerToggle || !layerPanel) return;

    function syncComparisonControls(): void {
      const mode = !periodMapVisible() ? "modern" : Number(opacitySlider?.value) === 100 ? "chart" : "blend";
      layerPanel?.querySelectorAll<HTMLButtonElement>("[data-map-comparison]").forEach((button) => {
        button.setAttribute("aria-pressed", String(button.dataset.mapComparison === mode));
      });
    }

    function syncPeriodMap(): void {
      const visible = periodMapVisible();
      const state = visibilityCheckbox?.checked ? periodMapState : "idle";
      syncComparisonControls();
      syncCoordinateGrid(m, visible);
      if (m.getLayer(BASEMAP_WATER_LABEL_LAYER_ID)) {
        m.setLayoutProperty(BASEMAP_WATER_LABEL_LAYER_ID, "visibility", visible ? "none" : "visible");
      }
      if (m.getLayer(periodMapLayer)) {
        m.setLayoutProperty(periodMapLayer, "visibility", visible ? "visible" : "none");
      }
      if (layerBadge) {
        layerBadge.textContent = { idle: "Off", loading: "Loading", ready: "On", error: "Unavailable" }[state];
        layerBadge.classList.toggle("map-layer-control__badge--active", visible);
      }
      if (sliderGroup) sliderGroup.hidden = !visible;
      if (layerStatus) {
        layerStatus.dataset.state = state;
        layerStatus.classList.toggle("sr-only", state === "idle" || state === "ready");
        layerStatus.textContent = {
          idle: "Herman Moll reference map off.",
          loading: "Loading the registered chart…",
          ready: "Herman Moll reference map on.",
          error: "The chart could not load. Choose Blend or Registered chart to retry.",
        }[state];
      }
    }

    const onPeriodMapUnavailable = () => {
      periodMapState = "error";
      syncPeriodMap();
    };

    function watchPeriodMapSource(source: ImageSource): void {
      periodMapState = "loading";
      source.once("error", onPeriodMapUnavailable);
      source.on("data", (event) => {
        // ImageSource.loaded() is also true after a failed request. Metadata
        // is emitted only once the image and its coordinates are available.
        if (event.sourceDataType !== "metadata") return;
        source.off("error", onPeriodMapUnavailable);
        const opacity = Number(opacitySlider?.value ?? 65) / 100;
        if (m.getLayer(periodMapLayer)) {
          m.setPaintProperty(periodMapLayer, "raster-opacity", opacity);
        } else {
          m.addLayer({
            id: periodMapLayer,
            type: "raster",
            source: periodMapSource,
            layout: { visibility: visibilityCheckbox?.checked ? "visible" : "none" },
            paint: {
              "raster-opacity": opacity,
              "raster-resampling": "linear",
            },
          }, m.getLayer("historical-routes-line")?.id);
        }
        periodMapState = "ready";
        syncPeriodMap();
      });
    }

    function requestPeriodMap(): void {
      if (periodMapState === "loading" || periodMapState === "ready") return;
      try {
        // Replace the failed source to give each retry a fresh request.
        if (m.getLayer(periodMapLayer)) m.removeLayer(periodMapLayer);
        if (m.getSource(periodMapSource)) m.removeSource(periodMapSource);
        const url = layerControl?.dataset.rectifiedUrl;
        const coordinates = JSON.parse(layerControl?.dataset.coordinates ?? "null");
        if (!url || !Array.isArray(coordinates) || coordinates.length !== 4) {
          onPeriodMapUnavailable();
          return;
        }
        m.addSource(periodMapSource, { type: "image", url, coordinates: coordinates as ImageSource["coordinates"] });
        watchPeriodMapSource(m.getSource<ImageSource>(periodMapSource)!);
      } catch {
        onPeriodMapUnavailable();
      }
    }

    const restorePeriodMap = () => {
      // Context restoration creates a new image source from MapLibre's saved
      // style. Its image request needs the same visibility and retry handling.
      const source = m.getSource<ImageSource>(periodMapSource);
      if (!source) return;
      watchPeriodMapSource(source);
      syncPeriodMap();
    };
    m.on("style.load", restorePeriodMap);
    subscriptions.push(() => m.off("style.load", restorePeriodMap));

    layerPanel.querySelectorAll<HTMLButtonElement>("[data-map-comparison]").forEach((button) => listen(button, "click", () => {
      if (!visibilityCheckbox || !opacitySlider) return;
      const mode = button.dataset.mapComparison;
      if (mode !== "modern") {
        opacitySlider.value = String(mode === "chart" ? 100 : blendOpacity);
        opacitySlider.dispatchEvent(new Event("input", { bubbles: true }));
      }
      visibilityCheckbox.checked = mode !== "modern";
      visibilityCheckbox.dispatchEvent(new Event("change", { bubbles: true }));
    }));

    listen(layerToggle, "click", () => {
      const isExpanded = layerToggle.getAttribute("aria-expanded") === "true";
      if (isExpanded) {
        closeLayerPanel();
      } else {
        openLayerPanel();
      }
    });

    listen(layerToggle, "keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        const isExpanded = layerToggle.getAttribute("aria-expanded") === "true";
        if (isExpanded) {
          closeLayerPanel();
        } else {
          openLayerPanel();
        }
      }
    });

    listen(layerPanelClose, "click", () => {
      closeLayerPanel();
      layerToggle.focus();
    });

    listen(layerPanel, "keydown", (e) => {
      if (e.key === "Escape") {
        e.preventDefault();
        e.stopPropagation();
        closeLayerPanel();
        layerToggle.focus();
      }
    });

    listen(visibilityCheckbox, "change", () => {
      if (visibilityCheckbox?.checked) requestPeriodMap();
      syncPeriodMap();
    });

    listen(opacitySlider, "input", () => {
      if (!opacitySlider) return;
      const val = Number(opacitySlider.value);
      if (val < 100) blendOpacity = val;
      const opacity = val / 100;
      if (opacityVal) {
        opacityVal.textContent = `${val}%`;
      }
      opacitySlider.setAttribute("aria-valuenow", String(val));
      syncComparisonControls();
      if (m.getLayer(periodMapLayer)) {
        m.setPaintProperty(periodMapLayer, "raster-opacity", opacity);
      }
    });

    const triggerInspect = () => {
      const sourceId = layerControl.dataset.sourceId;
      if (!sourceId) return;
      let assertionIds: string[] = [];
      try {
        assertionIds = JSON.parse(layerControl.dataset.assertionIds || "[]");
      } catch (err) {
        console.error("Failed to parse assertion IDs:", err);
      }

      window.dispatchEvent(
        new CustomEvent("cc:open-source", {
          detail: {
            sourceId,
            assertionIds,
            triggerEl: inspectBtn,
          },
        })
      );
      // Do not call closeLayerPanel() so inspectBtn remains the active returnElement in the DOM
    };

    listen(inspectBtn, "click", triggerInspect);
    listen(inspectBtn, "keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        triggerInspect();
      }
    });

    listen(window, "click", (e) => {
      // Source inspection returns focus here. Keep its trigger visible while
      // interacting with, or closing, the adjacent evidence surface.
      if (e.target instanceof Element && e.target.closest('[data-component="source-drawer"]')) return;
      if (!layerControl.contains(e.target as Node)) {
        closeLayerPanel();
      }
    });

    listen(document, "focusin", (e) => {
      const target = e.target;
      if (layerPanel.hidden || !(target instanceof Element) || layerControl.contains(target)) return;
      if (target.closest('[data-component="source-drawer"]')) return;
      closeLayerPanel();
    });
  }

  function initLocatorBrowser(): void {
    if (!locatorBrowser || !locatorToggle || !locatorMenu) return;

    listen(locatorToggle, "click", (e) => {
      const isKeyboard = e.detail === 0;
      const isExpanded = locatorToggle.getAttribute("aria-expanded") === "true";
      if (isExpanded) {
        closeLocatorMenu();
      } else {
        openLocatorMenu(isKeyboard);
      }
    });

    listen(locatorToggle, "keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        const isExpanded = locatorToggle.getAttribute("aria-expanded") === "true";
        if (isExpanded) {
          closeLocatorMenu();
        } else {
          openLocatorMenu(true);
        }
      } else if (e.key === "ArrowDown") {
        e.preventDefault();
        openLocatorMenu(true);
      }
    });

    listen(locatorFilterInput, "input", () => {
      if (locatorFilterInput) applyPlaceFilter(locatorFilterInput.value);
    });

    listen(locatorFilterInput, "keydown", (e) => {
      if (!locatorFilterInput) return;
      if (e.key === "ArrowDown") {
        e.preventDefault();
        e.stopPropagation();
        const firstVisible = getVisibleLocatorButtons()[0];
        firstVisible?.focus();
      } else if (e.key === "Escape") {
        e.preventDefault();
        e.stopPropagation();
        if (locatorFilterInput.value) {
          locatorFilterInput.value = "";
          applyPlaceFilter("");
        } else {
          closeLocatorMenu();
          locatorToggle.focus();
        }
      }
    });

    locatorItems.forEach((btn) => {
      listen(btn, "click", () => {
        const placeId = btn.dataset.placeId;
        if (placeId) {
          recordSelectionTrigger({
            modality: "pointer",
            origin: "locator_menu",
            returnTarget: locatorToggle,
          });
          selectionStore.set({ kind: "port", id: placeId });
          closeLocatorMenu();
          locatorToggle.focus();
        }
      });
    });

    listen(locatorMenu, "keydown", (e) => {
      if (e.key === "Escape") {
        e.preventDefault();
        e.stopPropagation();
        closeLocatorMenu();
        locatorToggle.focus();
        return;
      }

      const visibleButtons = getVisibleLocatorButtons();
      const activeBtn = document.activeElement as HTMLButtonElement;
      const activeIdx = visibleButtons.indexOf(activeBtn);

      if (e.key === "Enter" || e.key === " ") {
        if (activeIdx >= 0) {
          e.preventDefault();
          const placeId = activeBtn.dataset.placeId;
          if (placeId) {
            recordSelectionTrigger({
              modality: "keyboard",
              origin: "locator_menu",
              returnTarget: locatorToggle,
            });
            selectionStore.set({ kind: "port", id: placeId });
            closeLocatorMenu();
            locatorToggle.focus();
          }
        }
        return;
      }

      if (e.key === "ArrowDown") {
        if (document.activeElement === locatorFilterInput) return;
        e.preventDefault();
        if (visibleButtons.length > 0) {
          const nextIdx = activeIdx >= 0 ? (activeIdx + 1) % visibleButtons.length : 0;
          visibleButtons[nextIdx]?.focus();
        }
      } else if (e.key === "ArrowUp") {
        if (document.activeElement === locatorFilterInput) return;
        e.preventDefault();
        if (activeIdx === 0 && locatorFilterInput) {
          locatorFilterInput.focus();
        } else if (visibleButtons.length > 0) {
          const prevIdx = activeIdx > 0 ? activeIdx - 1 : visibleButtons.length - 1;
          visibleButtons[prevIdx]?.focus();
        }
      } else if (e.key === "Home") {
        if (document.activeElement !== locatorFilterInput && visibleButtons.length > 0) {
          e.preventDefault();
          visibleButtons[0]?.focus();
        }
      } else if (e.key === "End") {
        if (document.activeElement !== locatorFilterInput && visibleButtons.length > 0) {
          e.preventDefault();
          visibleButtons[visibleButtons.length - 1]?.focus();
        }
      }
    });

    listen(window, "click", (e) => {
      if (!locatorBrowser.contains(e.target as Node)) {
        closeLocatorMenu();
      }
    });
  }

  initMap();
</script>

