---
/**
 * src/components/inspector/EntityInspector.astro
 *
 * Sourced Entity Inspector for Charted Currents.
 * Renders verified historical metadata, crew demographics, evidence badges,
 * contemporary cartographic visuals, network connections, and aggregated route views.
 */
import entitiesJson from "../../../public/data/entities.json";
import eventsJson from "../../../public/data/events.json";
import routesJson from "../../../public/data/routes.geojson?raw";
import type { PublishedEntities, PublishedEvent, PublishedRouteFeatureCollection } from "../../lib/domain/types";
import { publishedSelectionIds } from "../../lib/state/navigation";
const selectionIds = publishedSelectionIds(
  entitiesJson as unknown as PublishedEntities,
  (Array.isArray(eventsJson) ? eventsJson : eventsJson.events) as PublishedEvent[],
  JSON.parse(routesJson) as PublishedRouteFeatureCollection,
);
---

<script is:inline type="application/json" data-published-selection-ids set:html={JSON.stringify(selectionIds).replace(/</g, "\\u003c")} />

<aside
  id="entity-inspector"
  class="inspector-shell"
  aria-label="Entity inspector"
  data-component="entity-inspector"
  data-state="closed"
  data-sheet-state="closed"
  hidden
>
  <!-- Mobile bottom sheet handle affordance -->
  <div class="inspector-sheet__handle-wrap">
    <button
      type="button"
      class="inspector-sheet__handle"
      aria-label="Expand entity details"
      aria-expanded="false"
      aria-controls="inspector-content"
      data-sheet-handle
    >
      <span class="inspector-sheet__handle-bar" aria-hidden="true"></span>
    </button>
  </div>

  <header class="inspector-header">
    <div class="inspector-header__kicker-wrap">
      <p class="panel-kicker" data-inspector-kicker>Historical Entity</p>
      <div data-inspector-badge-wrap hidden>
        <span class="evidence-badge" data-inspector-badge data-evidence-state="documented">Documented</span>
      </div>
    </div>
    <button
      type="button"
      class="inspector-close"
      aria-label="Close inspector"
      title="Close inspector (Esc)"
      data-inspector-close
    >
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M1 1l12 12M13 1L1 13" />
      </svg>
    </button>
  </header>

  <div id="inspector-content" class="inspector-content">
    <!-- Out-of-period focus notice banner -->
    <div class="inspector-period-notice" data-period-notice data-inspector-period-notice hidden aria-live="polite">
      <span class="inspector-period-notice__icon" aria-hidden="true">⏱</span>
      <span class="inspector-period-notice__text" data-period-notice-text>Outside current period focus</span>
    </div>

    <div class="inspector-title-group">
      <h2 id="inspector-heading" class="inspector-title" data-inspector-title tabindex="-1"></h2>
      <p class="inspector-subtitle" data-inspector-subtitle></p>
    </div>

    <p class="inspector-field-note" data-inspector-status role="status" hidden></p>
    <button type="button" class="inspector-evidence-btn" data-inspector-retry hidden>Try loading again</button>

    <div class="inspector-body">
      <!-- PLACE VIEW -->
      <div data-view-place hidden>
        <section class="inspector-section" aria-label="Geographic reference">
          <p class="panel-kicker">Geographic Reference</p>
          <dl class="inspector-meta">
            <div class="inspector-meta__row">
              <dt>Raw Recorded Name</dt>
              <dd data-place-raw-name class="inspector-mono"></dd>
            </div>
            <div class="inspector-meta__row">
              <dt>Geographic Precision</dt>
              <dd data-place-precision></dd>
            </div>
            <div class="inspector-meta__row">
              <dt>Navigation Coordinates</dt>
              <dd data-place-coords class="inspector-mono"></dd>
            </div>
            <div class="inspector-meta__row">
              <dt>Geometry Provenance</dt>
              <dd data-place-geom-provenance class="inspector-mono"></dd>
            </div>
          </dl>
        </section>

        <section class="inspector-section" aria-label="Historical context">
          <p class="panel-kicker">Historical Context</p>
          <p class="inspector-note" data-place-note></p>
        </section>

        <!-- Sourced Historical Visual Section for Jamaica / Port Royal -->
        <section class="inspector-section" data-place-visual-wrap hidden aria-label="Historical map reference">
          <p class="panel-kicker">Contemporary Cartographic Reference</p>
          <div class="inspector-visual-card">
            <img
              src="/assets/visuals/bochart-knollis-jamaica-1684.jpg"
              alt="A new & exact mapp of the island of Jamaica, [1684?]"
              class="inspector-visual-img"
              width="1967"
              height="872"
              loading="lazy"
            />
            <div class="inspector-visual-caption">
              <p class="inspector-visual-title">A new &amp; exact mapp of the island of Jamaica [1684?]</p>
              <p class="inspector-visual-creator">Charles Bochart &amp; Humphrey Knollis · Philip Lea, London</p>
              <p class="inspector-visual-credit">Library of Congress, Geography &amp; Map Division (G4960 1684 .B6 / ct008911)</p>
              <p class="inspector-visual-desc" data-place-visual-desc>
                Contemporary engraved map depicting the island parishes and harbor settlements.
              </p>
            </div>
          </div>
        </section>

        <!-- Place Connections -->
        <section class="inspector-section" data-place-connections-wrap hidden aria-label="Network connections">
          <p class="panel-kicker">Network Connections</p>
          <div class="inspector-connections-list" data-place-connections-list></div>
        </section>

        <!-- Dataset Context Section (Packet 7) -->
        <section class="inspector-section" data-place-dataset-context-wrap hidden aria-label="Dataset context">
          <div class="inspector-dataset-context-header">
            <p class="panel-kicker">Dataset Context</p>
            <span class="inspector-dataset-context-badge">CrespoDynCoopNet analytical context</span>
          </div>

          <div data-place-dataset-context-content>
            <p class="inspector-dataset-context-summary" data-place-context-summary></p>
            <p class="inspector-dataset-context-roles" data-place-context-roles hidden></p>
            <p class="inspector-dataset-context-overlap-note" data-place-context-overlap-note hidden></p>
            <p class="inspector-dataset-context-baseline-note" data-place-context-baseline-note hidden></p>

            <div data-place-context-counterparts-wrap hidden>
              <p class="inspector-dataset-context-subheading">Recorded counterparts (<span data-place-context-period-label></span>):</p>
              <ul class="inspector-dataset-context-list" data-place-context-counterparts-list></ul>
            </div>

            <p class="inspector-field-note" data-place-context-caveat></p>
          </div>
        </section>

        <section class="inspector-section" aria-label="Place evidence">
          <p class="panel-kicker">Archival Provenance</p>
          <button type="button" class="inspector-evidence-btn" data-place-evidence-btn data-open-place-source>
            Inspect Supporting Sourced Evidence ↗
          </button>
        </section>
      </div>

      <!-- SHIP VIEW -->
      <div data-view-ship hidden>
        <section class="inspector-section" aria-label="Vessel recorded facts">
          <p class="panel-kicker">Documented Vessel Facts</p>
          <dl class="inspector-meta">
            <div class="inspector-meta__row">
              <dt>Raw Vessel Name</dt>
              <dd data-ship-raw-name class="inspector-mono"></dd>
            </div>
            <div class="inspector-meta__row">
              <dt>Reported Burden</dt>
              <dd data-ship-tonnage class="inspector-mono"></dd>
            </div>
            <div class="inspector-meta__row">
              <dt>Construction Origin</dt>
              <dd data-ship-construction></dd>
            </div>
            <div class="inspector-meta__row" data-ship-owner-row>
              <dt>Owner Residence</dt>
              <dd data-ship-owner></dd>
            </div>
            <div class="inspector-meta__row" data-ship-master-row hidden>
              <dt>Recorded Master</dt>
              <dd data-ship-master></dd>
            </div>
            <div class="inspector-meta__row" data-ship-fleet-row hidden>
              <dt>Fleet Convoy</dt>
              <dd data-ship-fleet></dd>
            </div>
            <div class="inspector-meta__row">
              <dt data-ship-voyage-label>Recorded Voyage</dt>
              <dd data-ship-voyage></dd>
            </div>
            <div class="inspector-meta__row" data-ship-capture-row>
              <dt>Capture Record</dt>
              <dd data-ship-capture></dd>
            </div>
            <div class="inspector-meta__row" data-ship-register-row hidden>
              <dt>Archival Register</dt>
              <dd data-ship-register></dd>
            </div>
          </dl>
        </section>

        <!-- Crew Roster Table -->
        <section class="inspector-section" data-ship-crew-section hidden aria-label="Recorded crew">
          <p class="panel-kicker">Recorded crew</p>
          <p class="inspector-crew-caption">Crew entries from inspected dataset records. Original manuscripts were not independently examined by Charted Currents.</p>
          <div class="inspector-table-wrap">
            <table class="inspector-crew-table">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Rank / Role</th>
                  <th>Birthplace / Origin</th>
                  <th>Sovereignty / Allegiance</th>
                </tr>
              </thead>
              <tbody data-ship-crew-tbody></tbody>
            </table>
          </div>
        </section>

        <!-- Fleet Convoy Context -->
        <section class="inspector-section" data-ship-fleet-context hidden aria-label="Fleet convoy context">
          <p class="panel-kicker">Fleet & Convoy Organization</p>
          <dl class="inspector-meta">
            <div class="inspector-meta__row">
              <dt>Convoy Title</dt>
              <dd data-fleet-title></dd>
            </div>
            <div class="inspector-meta__row">
              <dt>Fleet Commander</dt>
              <dd data-fleet-commander></dd>
            </div>
            <div class="inspector-meta__row">
              <dt>Fleet-level Origin / Destination</dt>
              <dd data-fleet-route></dd>
            </div>
          </dl>
          <p class="inspector-field-note">Fleet-level context from the Crespo FLOTAS dataset record; the vessel's recorded voyage endpoint is shown separately above.</p>
          <button type="button" class="inspector-evidence-btn" data-fleet-evidence-btn>
            Inspect Fleet Register Provenance ↗
          </button>
        </section>

        <!-- Recorded Goods (Packet 6) -->
        <section class="inspector-section" data-ship-goods-section hidden aria-label="Recorded goods">
          <p class="panel-kicker">Recorded Goods (Crespo CSIC)</p>
          <div data-ship-goods-value-banner hidden class="inspector-goods-value-banner">
            <span class="inspector-goods-value-label">Recorded Total Goods Value:</span>
            <span class="inspector-goods-value-amount" data-ship-goods-total-value></span>
            <p class="inspector-field-note">Recorded for the vessel cargo set in prize capture context; individual lines are unitemized.</p>
          </div>
          <div data-ship-goods-summary-box hidden class="inspector-goods-summary-box">
            <dl class="inspector-meta">
              <div class="inspector-meta__row">
                <dt>Vessel Goods Summary</dt>
                <dd data-ship-goods-summary-text class="inspector-mono"></dd>
              </div>
            </dl>
            <p data-ship-goods-discrepancy-note hidden class="inspector-field-note">
              Itemized Crespo rows differ from this summary. Inspect evidence in drawer.
            </p>
          </div>
          <div class="inspector-goods-badges-wrap" data-ship-goods-badges></div>
          <p data-ship-goods-consignees-note hidden class="inspector-field-note" data-ship-goods-consignees-text></p>
          <p data-ship-goods-measure-note hidden class="inspector-field-note" data-ship-goods-measure-text></p>
          <button type="button" class="inspector-evidence-btn" data-ship-goods-evidence-btn>
            Inspect Recorded Goods in Source Drawer ↗
          </button>
        </section>

        <!-- Privateering Engagement & Petition Section (Packet 11) -->
        <section class="inspector-section" data-ship-privateering-section hidden aria-label="Privateering encounter & petition">
          <p class="panel-kicker">Privateering Encounter & Petition</p>
          <div data-privateering-linkage-wrap hidden class="inspector-cross-archive-linkage">
            <div class="inspector-cross-archive-header">
              <span class="inspector-cross-archive-label">Cross-archive linkage:</span>
              <span class="evidence-badge" data-privateering-linkage-state data-evidence-state="probable_match">Probable match</span>
            </div>
            <p class="inspector-field-note" data-privateering-linkage-note></p>
          </div>
          <dl class="inspector-meta">
            <div class="inspector-meta__row" data-privateering-engagement-row>
              <dt>Recorded Action</dt>
              <dd data-privateering-engagement></dd>
            </div>
            <div class="inspector-meta__row" data-privateering-resistance-row>
              <dt>Crew Resistance</dt>
              <dd data-privateering-resistance></dd>
            </div>
            <div class="inspector-meta__row" data-privateering-plunder-row>
              <dt>Cargo Plunder</dt>
              <dd data-privateering-plunder></dd>
            </div>
            <div class="inspector-meta__row" data-privateering-petition-row>
              <dt>Queen Anne Petition</dt>
              <dd data-privateering-petition></dd>
            </div>
          </dl>
          <p class="inspector-field-note" data-privateering-upstream-note></p>
          <button type="button" class="inspector-evidence-btn" data-privateering-evidence-btn>
            Inspect Council of Trade Report in Source Drawer ↗
          </button>
        </section>

        <!-- Ship Connections -->
        <section class="inspector-section" data-ship-connections-wrap hidden aria-label="Network connections">
          <p class="panel-kicker">Network Connections</p>
          <div class="inspector-connections-list" data-ship-connections-list></div>
        </section>

        <section class="inspector-section" aria-label="Ship provenance">
          <p class="panel-kicker">Archival Provenance</p>
          <div class="inspector-provenance-box">
            <p class="inspector-provenance-title">UK Data Service SN 852135 (IMLM)</p>
            <p class="inspector-provenance-subtitle" data-ship-upstream-ref></p>
            <button type="button" class="inspector-evidence-btn" data-ship-evidence-btn data-open-ship-source>
              Inspect Supporting Sourced Evidence ↗
            </button>
          </div>
        </section>
      </div>

      <!-- EVENT VIEW -->
      <div data-view-event hidden>
        <section class="inspector-section" aria-label="Historical event details">
          <p class="panel-kicker">Event Summary</p>
          <dl class="inspector-meta">
            <div class="inspector-meta__row">
              <dt>Historical Date</dt>
              <dd data-event-date class="inspector-mono"></dd>
            </div>
            <div class="inspector-meta__row">
              <dt>Event Kind</dt>
              <dd data-event-kind></dd>
            </div>
            <div class="inspector-meta__row">
              <dt>Location</dt>
              <dd data-event-place></dd>
            </div>
          </dl>
          <p class="inspector-note" data-event-summary></p>
        </section>

        <!-- Event Connections -->
        <section class="inspector-section" data-event-connections-wrap hidden aria-label="Network connections">
          <p class="panel-kicker">Network Connections</p>
          <div class="inspector-connections-list" data-event-connections-list></div>
        </section>

        <section class="inspector-section" aria-label="Event sources">
          <p class="panel-kicker">Archival Provenance</p>
          <button type="button" class="inspector-evidence-btn" data-event-evidence-btn data-open-event-source>
            Inspect Supporting Sourced Evidence ↗
          </button>
        </section>
      </div>

      <!-- VOYAGE / ROUTE GROUP VIEW -->
      <div data-view-voyage hidden>
        <section class="inspector-section" aria-label="Documented route connection">
          <p class="panel-kicker">Route Segment</p>
          <dl class="inspector-meta">
            <div class="inspector-meta__row">
              <dt>Origin Place</dt>
              <dd data-voyage-origin></dd>
            </div>
            <div class="inspector-meta__row">
              <dt>Destination Place</dt>
              <dd data-voyage-destination></dd>
            </div>
            <div class="inspector-meta__row">
              <dt>Documented Voyages</dt>
              <dd data-voyage-count class="inspector-mono"></dd>
            </div>
          </dl>
          <p class="inspector-note">
            Dashed line connects documented endpoint places. Constituent vessels represent distinct archival records sharing this directional trajectory.
          </p>
        </section>

        <section class="inspector-section" aria-label="Constituent vessel records">
          <p class="panel-kicker">Documented Vessel Voyages</p>
          <div class="inspector-connections-list" data-voyage-vessels-list></div>
        </section>
      </div>

      <!-- PERSON VIEW -->
      <div data-view-person hidden>
        <section class="inspector-section" aria-label="Person recorded facts">
          <p class="panel-kicker">Maritime Actor Context</p>
          <dl class="inspector-meta">
            <div class="inspector-meta__row">
              <dt>Recorded Role</dt>
              <dd data-person-role></dd>
            </div>
            <div class="inspector-meta__row">
              <dt>Recorded Occurrence Span</dt>
              <dd data-person-active-years class="inspector-mono"></dd>
            </div>
            <div class="inspector-meta__row">
              <dt>Resolution Status</dt>
              <dd data-person-resolution-status></dd>
            </div>
          </dl>
          <p class="inspector-note" data-person-notes></p>
        </section>

        <section class="inspector-section" aria-label="Archival occurrences">
          <p class="panel-kicker" data-person-voyages-kicker>Archival Occurrences</p>
          <div class="inspector-connections-list" data-person-voyages-list></div>
        </section>

        <section class="inspector-section" aria-label="Person provenance">
          <p class="panel-kicker">Archival Provenance</p>
          <button type="button" class="inspector-evidence-btn" data-person-evidence-btn>
            Inspect Supporting Sourced Evidence ↗
          </button>
        </section>
      </div>
    </div>
  </div>
</aside>

<script>
  import "../../lib/inspector/bootstrap";
</script>

<style>
  .inspector-shell {
    position: absolute;
    top: 1rem;
    right: 1rem;
    bottom: 1rem;
    width: 380px;
    max-width: calc(100vw - 2rem);
    background: var(--cc-paper-raised);
    border: 1px solid var(--cc-line);
    border-radius: var(--cc-radius-md);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.16);
    display: flex;
    flex-direction: column;
    z-index: 100;
    overflow: hidden;
  }

  .inspector-shell[hidden] {
    display: none !important;
  }

  .inspector-sheet__handle-wrap {
    display: none;
  }

  .inspector-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--cc-line);
    background: var(--cc-paper);
  }

  .inspector-header__kicker-wrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .inspector-close {
    background: transparent;
    border: none;
    padding: 0.35rem;
    color: var(--cc-ink-muted);
    cursor: pointer;
    border-radius: var(--cc-radius-xs);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 120ms ease, background 120ms ease;
  }

  .inspector-close:hover,
  .inspector-close:focus-visible {
    color: var(--cc-ink);
    background: color-mix(in srgb, var(--cc-line) 50%, transparent);
    outline: none;
  }

  .inspector-content {
    padding: 1.25rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .inspector-period-notice {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.65rem;
    background: color-mix(in srgb, var(--cc-sand) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--cc-sand) 40%, transparent);
    border-radius: var(--cc-radius-xs);
    font-size: 0.72rem;
    color: var(--cc-ink-muted);
  }

  .inspector-period-notice[hidden] {
    display: none !important;
  }

  .inspector-title {
    font-family: var(--cc-font-serif);
    font-size: var(--cc-text-lg);
    font-weight: 400;
    color: var(--cc-ink);
    margin: 0 0 0.25rem;
  }

  .inspector-subtitle {
    font-size: var(--cc-text-xs);
    color: var(--cc-ink-muted);
    margin: 0;
  }

  .inspector-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .inspector-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .inspector-section[hidden] {
    display: none !important;
  }

  .inspector-note {
    font-size: var(--cc-text-xs);
    line-height: 1.5;
    color: var(--cc-ink-muted);
    margin: 0;
  }

  .inspector-connections-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .inspector-shell :global(.inspector-rel-row),
  .inspector-rel-row {
    text-align: left;
    background: var(--cc-paper);
    border: 1px solid var(--cc-line);
    border-radius: var(--cc-radius-xs);
    padding: 0.45rem 0.65rem;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--cc-font-sans);
    cursor: pointer;
    transition: background 120ms ease, border-color 120ms ease;
    width: 100%;
  }

  .inspector-shell :global(.inspector-rel-row:hover),
  .inspector-shell :global(.inspector-rel-row:focus-visible),
  .inspector-rel-row:hover,
  .inspector-rel-row:focus-visible {
    background: color-mix(in srgb, var(--cc-paper-raised) 80%, transparent);
    border-color: var(--cc-sand);
    outline: none;
  }

  .inspector-shell :global(.inspector-rel-type),
  .inspector-rel-type {
    font-family: var(--cc-font-mono);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cc-sand);
    flex-shrink: 0;
    min-width: 4.2rem;
  }

  .inspector-shell :global(.inspector-rel-content),
  .inspector-rel-content {
    flex-grow: 1;
    font-size: var(--cc-text-xs);
    color: var(--cc-ink);
    line-height: 1.35;
  }

  .inspector-shell :global(.inspector-rel-role),
  .inspector-rel-role {
    font-size: 0.72rem;
    color: var(--cc-ink-muted);
  }

  .inspector-shell :global(.inspector-rel-sep),
  .inspector-rel-sep {
    color: var(--cc-line-strong);
    padding: 0 0.15rem;
  }

  .inspector-shell :global(.inspector-rel-label),
  .inspector-rel-label {
    font-weight: 500;
    color: var(--cc-ink);
  }

  .inspector-shell :global(.inspector-link-btn),
  .inspector-link-btn {
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    font-size: inherit;
    color: var(--cc-sand);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 120ms ease;
    text-align: left;
  }

  .inspector-shell :global(.inspector-link-btn:hover),
  .inspector-shell :global(.inspector-link-btn:focus-visible),
  .inspector-link-btn:hover,
  .inspector-link-btn:focus-visible {
    color: var(--cc-ink);
    outline: none;
  }

  .inspector-evidence-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    width: 100%;
    padding: 0.55rem 0.85rem;
    background: var(--cc-paper);
    border: 1px solid var(--cc-line);
    border-radius: var(--cc-radius-xs);
    font-family: var(--cc-font-sans);
    font-size: var(--cc-text-xs);
