---
/**
 * src/components/timeline/TimelineRail.astro
 *
 * Sourced Timeline Rail for Charted Currents.
 * Renders data-driven dual lanes (Contextual vs Prize Captures), sample coverage shading,
 * collision-free hover/focus tooltips, and a reactive 3-way temporal period focus store.
 */
import eventsData from "../../../public/data/events.json";
import coverageData from "../../../public/data/coverage.json";
import { TIMELINE_RANGE } from "../../lib/time/config";

const majorYears = [1650, 1670, 1690, 1710, 1730] as const;
const allDecades = [1650, 1660, 1670, 1680, 1690, 1700, 1710, 1720, 1730] as const;
const totalSpan = TIMELINE_RANGE.endYear - TIMELINE_RANGE.startYear;

const rawEvents = (eventsData.events || eventsData || []) as Array<{
  id: string;
  date: string;
  title: string;
  kind: string;
  vessel_id?: string;
  evidence_state: string;
}>;

function parseFractionalYear(dateStr: string): number {
  if (!dateStr) return 1700.5;
  const parts = dateStr.split("-");
  const year = parseInt(parts[0], 10);
  if (parts.length >= 3 && parts[1] && parts[2]) {
    const month = parseInt(parts[1], 10);
    const day = parseInt(parts[2], 10);
    return year + (month - 1) / 12 + (day - 1) / (30 * 12);
  }
  if (parts.length >= 2 && parts[1]) {
    const month = parseInt(parts[1], 10);
    return year + (month - 0.5) / 12;
  }
  return year + 0.5;
}

const parsedEvents = rawEvents.map((ev) => {
  const yearMatch = ev.date.match(/^(\d{4})/);
  const year = yearMatch ? parseInt(yearMatch[1], 10) : 1700;
  const fractionalYear = parseFractionalYear(ev.date);
  const isContext = ev.kind === "environmental" || !ev.vessel_id;
  return {
    id: ev.id,
    year,
    fractionalYear,
    title: ev.title,
    date: ev.date,
    kind: "event" as const,
    selectionId: ev.id,
    state: ev.evidence_state,
    isContext,
  };
});

// Compute collision-free vertical stacking sub-lanes per lane
const contextEvents = parsedEvents.filter((e) => e.isContext).sort((a, b) => a.fractionalYear - b.fractionalYear);
const captureEvents = parsedEvents.filter((e) => !e.isContext).sort((a, b) => a.fractionalYear - b.fractionalYear);

function assignStackIndices(events: typeof parsedEvents) {
  let prevPos = -999;
  let currentStack = 0;
  return events.map((e) => {
    const pos = ((e.fractionalYear - TIMELINE_RANGE.startYear) / totalSpan) * 100;
    if (pos - prevPos < 1.8) {
      currentStack = (currentStack + 1) % 3;
    } else {
      currentStack = 0;
    }
    prevPos = pos;
    return {
      ...e,
      position: pos,
      stackIndex: currentStack,
    };
  });
}

const formattedEvents = [
  ...assignStackIndices(contextEvents),
  ...assignStackIndices(captureEvents),
];

// Data-driven coverage elements compiled from coverage.json
const continuousCoverages = (coverageData as any[]).filter(
  (cov: any) => cov.project_reviewed_sample?.sample_type === "continuous_chronological_sample"
).map((cov: any) => ({
  label: `${cov.project_reviewed_sample.start_year}–${cov.project_reviewed_sample.end_year} ${cov.short_label}`,
  start: cov.project_reviewed_sample.start_year,
  end: cov.project_reviewed_sample.end_year,
  caveat: cov.project_reviewed_sample.caveat,
}));

const discreteCoverages = (coverageData as any[]).filter(
  (cov: any) => cov.project_reviewed_sample?.sample_type === "discrete_carrera_records"
).flatMap((cov: any) => {
  const years = (cov.project_reviewed_sample.discrete_years || [1684, 1694, 1695, 1706]) as number[];
  return years.map((yr: number, idx: number) => {
    const prevYear = idx > 0 ? years[idx - 1] : null;
    const isClose = prevYear !== null && (yr - prevYear <= 2);
    return {
      year: yr,
      label: `${yr} ${cov.short_label}`,
      caveat: cov.project_reviewed_sample.caveat,
      isClose,
    };
  });
});
---

<section
  class="timeline-shell"
  aria-label="Historical timeline"
  data-component="timeline-rail"
  data-interactive="true"
>
  <div class="timeline-shell__top">
    <div class="timeline-shell__heading">
      <p class="panel-kicker">Period Focus</p>
      <div class="timeline-filters" role="group" aria-label="Temporal period filter">
        <button type="button" class="timeline-filter-btn is-active" data-time-filter="all">All (1650–1730)</button>
        <button type="button" class="timeline-filter-btn" data-time-filter="1684-1695">1684–1695 (Early / Disaster Context)</button>
        <button type="button" class="timeline-filter-btn" data-time-filter="1702-1712">1702–1712 (Prize Papers Sample)</button>
      </div>
    </div>
  </div>

  <div class="timeline-shell__rail" aria-label="1650 to 1730 period rail">
    <!-- Source Coverage Background Shading & Discrete Markers -->
    <div class="timeline-coverage-layer" aria-hidden="true">
      {continuousCoverages.map((band) => {
        const left = ((band.start - TIMELINE_RANGE.startYear) / totalSpan) * 100;
        const width = ((band.end - band.start) / totalSpan) * 100;
        return (
          <div
            class="timeline-coverage-band timeline-coverage-band--continuous"
            style={`left: ${left}%; width: ${Math.max(width, 1.8)}%;`}
            title={`Documentary sample coverage: ${band.label} (${band.caveat})`}
          />
        );
      })}
      {discreteCoverages.map((marker) => {
        const left = ((marker.year - TIMELINE_RANGE.startYear) / totalSpan) * 100;
        return (
          <div
            class="timeline-coverage-marker timeline-coverage-marker--discrete"
            style={`left: ${left}%;`}
            title={`Discrete archival sample record: ${marker.label} (${marker.caveat})`}
          >
            <span class="timeline-coverage-marker-line"></span>
            <span class={`timeline-coverage-label ${marker.isClose ? "timeline-coverage-label--staggered" : ""}`}>
              {marker.year}
            </span>
          </div>
        );
      })}
    </div>

    <div class="timeline-shell__rule" aria-hidden="true"></div>

    <!-- Ticks & Decades -->
    <div class="timeline-shell__ticks" aria-hidden="true">
      {allDecades.map((year) => {
        const isMajor = (majorYears as readonly number[]).includes(year);
        const position = ((year - TIMELINE_RANGE.startYear) / totalSpan) * 100;
        return (
          <span
            class={`timeline-shell__tick ${isMajor ? "timeline-shell__tick--major" : "timeline-shell__tick--minor"}`}
            style={`--tick-position: ${position}%`}
          >
            <span class="timeline-shell__tick-mark" style={isMajor ? "height: 0.75rem;" : "height: 0.4rem; opacity: 0.5;"}></span>
            {isMajor && <span class="timeline-shell__tick-label">{year}</span>}
          </span>
        );
      })}
    </div>

    <!-- Dual Lanes for Interactive Event Markers -->
    <div class="timeline-shell__events" role="region" aria-label="Dated timeline occurrences">
      {formattedEvents.map((evt) => {
        const laneClass = evt.isContext ? "timeline-event-marker--context" : "timeline-event-marker--capture";
        const stackClass = `timeline-event-marker--stack-${evt.stackIndex}`;
        return (
          <button
            type="button"
            class={`timeline-event-marker ${laneClass} ${stackClass}`}
            data-timeline-event
            data-event-year={evt.year}
            data-event-kind="event"
            data-selection-id={evt.selectionId}
            data-evidence-state={evt.state}
            style={`left: ${evt.position}%`}
            aria-label={`${evt.date}: ${evt.title} (${evt.state})`}
          >
            <span class="timeline-event-dot" aria-hidden="true"></span>
            <span class="timeline-event-tooltip" role="tooltip">{evt.date}: {evt.title}</span>
          </button>
        );
      })}
    </div>
  </div>

  <div class="timeline-shell__footer">
    <span class="timeline-shell__note">
      Focus highlights Prize Papers-derived sample (1702–1712), discrete Spanish Atlantic registers (1684, 1694, 1695, 1706), and Port Royal contextual disaster history.
    </span>
  </div>
</section>

<script>
  import { recordSelectionTrigger } from "../../lib/map/interactionState";
  import { selectionStore } from "../../lib/state/selection";
  import { timeFilterStore } from "../../lib/state/timeFilter";

  const markers = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-timeline-event]"));
  const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-time-filter]"));

  let lastModality: "pointer" | "keyboard" = "pointer";

  window.addEventListener(
    "keydown",
    (e) => {
      if (e.key === "Enter" || e.key === " ") {
        lastModality = "keyboard";
        const active = document.activeElement;
        if (active && active.hasAttribute("data-timeline-event")) {
          const sid = active.getAttribute("data-selection-id");
          if (sid) {
            recordSelectionTrigger({
              modality: "keyboard",
              origin: "timeline",
              returnTarget: active as HTMLElement,
            });
            selectionStore.set({ kind: "event", id: sid });
          }
        }
      }
    },
    { capture: true }
  );

  window.addEventListener(
    "mousedown",
    () => {
      lastModality = "pointer";
    },
    { capture: true }
  );

  markers.forEach((btn) => {
    btn.addEventListener("click", () => {
      const selectionId = btn.getAttribute("data-selection-id");
      if (!selectionId) return;

      const modality = lastModality === "keyboard" ? "keyboard" : "pointer";

      recordSelectionTrigger({
        modality,
        origin: "timeline",
        returnTarget: btn,
      });

      lastModality = "pointer";
      selectionStore.set({ kind: "event", id: selectionId });
    });
  });

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filterKey = btn.getAttribute("data-time-filter") as "all" | "1684-1695" | "1702-1712";
      if (filterKey) {
        timeFilterStore.set(filterKey);
      }
    });
  });

  timeFilterStore.subscribe((filter) => {
    filterBtns.forEach((btn) => {
      const key = btn.getAttribute("data-time-filter");
      if (key === filter.id) {
        btn.classList.add("is-active");
        btn.setAttribute("aria-pressed", "true");
      } else {
        btn.classList.remove("is-active");
        btn.setAttribute("aria-pressed", "false");
      }
    });

    markers.forEach((btn) => {
      const yearAttr = btn.getAttribute("data-event-year");
      const year = yearAttr ? parseInt(yearAttr, 10) : 1700;
      if (filter.id === "all") {
        btn.style.opacity = "1";
        btn.style.pointerEvents = "auto";
      } else if (year >= filter.startYear && year <= filter.endYear) {
        btn.style.opacity = "1";
        btn.style.pointerEvents = "auto";
      } else {
        btn.style.opacity = "0.15";
        btn.style.pointerEvents = "none";
      }
    });
  });

  selectionStore.subscribe((selection) => {
    markers.forEach((btn) => {
      const sid = btn.getAttribute("data-selection-id");
      if (selection && sid === selection.id) {
        btn.classList.add("is-selected");
      } else {
        btn.classList.remove("is-selected");
      }
    });
  });
</script>

<style>
  .timeline-shell {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: var(--cc-space-2);
    padding: var(--cc-space-3) var(--cc-space-5);
    background: var(--cc-paper-raised);
    border-top: var(--cc-rule-thin) solid var(--cc-line-strong);
    box-shadow: 0 -2px 10px rgb(20 29 33 / 6%);
    font-family: var(--cc-font-sans);
  }

  .timeline-shell__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--cc-space-3);
  }

  .timeline-shell__heading {
    display: flex;
    align-items: center;
    gap: var(--cc-space-3);
    flex-wrap: wrap;
  }

  .timeline-filters {
    display: flex;
    align-items: center;
    gap: var(--cc-space-1);
    flex-wrap: wrap;
  }

  .timeline-filter-btn {
    appearance: none;
    background: var(--cc-paper);
    border: var(--cc-rule-thin) solid var(--cc-line);
    border-radius: var(--cc-radius-xs);
    padding: 0.2rem 0.55rem;
    font-family: var(--cc-font-sans);
    font-size: 0.6875rem;
    color: var(--cc-ink-muted);
    cursor: pointer;
    transition: all var(--cc-duration-fast) var(--cc-ease-standard);
  }

  .timeline-filter-btn:hover {
    color: var(--cc-ink);
    border-color: var(--cc-line-strong);
  }

  .timeline-filter-btn.is-active {
    background: var(--cc-ink);
    color: var(--cc-paper);
    border-color: var(--cc-ink);
    font-weight: 500;
  }

  .timeline-shell__rail {
    position: relative;
    height: 4.5rem;
    margin: 0.25rem 0;
  }

  .timeline-shell__events {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2.25rem;
  }

  .timeline-coverage-layer {
    position: absolute;
    top: 3.45rem;
    left: 0;
    right: 0;
    height: 1.25rem;
    pointer-events: none;
  }

  .timeline-coverage-band {
    position: absolute;
    top: 0;
    bottom: 0;
    background: color-mix(in srgb, var(--cc-sand) 14%, transparent);
    border-left: 1px dashed color-mix(in srgb, var(--cc-sand) 50%, transparent);
    border-right: 1px dashed color-mix(in srgb, var(--cc-sand) 50%, transparent);
    border-radius: var(--cc-radius-xs);
  }

  .timeline-coverage-marker--discrete {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    transform: translateX(-50%);
  }

  .timeline-coverage-marker-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
    background: color-mix(in srgb, var(--cc-sand) 40%, transparent);
    border-radius: 1px;
  }

  .timeline-coverage-label {
    position: absolute;
    top: 0;
    left: 0.2rem;
    font-family: var(--cc-font-mono);
    font-size: 0.55rem;
    color: var(--cc-sand);
    white-space: nowrap;
    opacity: 0.85;
  }

  .timeline-coverage-label--staggered {
    top: 0.65rem;
  }

  .timeline-shell__rule {
    position: absolute;
    top: 2.5rem;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--cc-line);
  }

  .timeline-shell__ticks {
    position: absolute;
    top: 2.5rem;
    left: 0;
    right: 0;
    height: 1rem;
    pointer-events: none;
  }

  .timeline-shell__tick {
    position: absolute;
    left: var(--tick-position);
    top: 0;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .timeline-shell__tick-mark {
    width: 1px;
    height: 4px;
    background: var(--cc-ink-muted);
  }

  .timeline-shell__tick-label {
    position: absolute;
    top: 0.35rem;
    font-family: var(--cc-font-mono);
    font-size: 0.625rem;
    color: var(--cc-ink-muted);
  }

  .timeline-event-marker {
    position: absolute;
    transform: translate(-50%, -50%);
    background: transparent;
    border: none;
    padding: 0.25rem;
    cursor: pointer;
    z-index: 2;
    transition: transform var(--cc-duration-fast) var(--cc-ease-standard), opacity var(--cc-duration-fast) var(--cc-ease-standard);
  }

  /* Top lane for Contextual events */
  .timeline-event-marker--context {
    top: 0.65rem;
  }
  .timeline-event-marker--context.timeline-event-marker--stack-0 {
    top: 0.65rem;
  }
  .timeline-event-marker--context.timeline-event-marker--stack-1 {
    top: 0.35rem;
  }
  .timeline-event-marker--context.timeline-event-marker--stack-2 {
    top: 0.95rem;
  }

  /* Bottom lane for Prize Captures */
  .timeline-event-marker--capture {
    top: 1.85rem;
  }
  .timeline-event-marker--capture.timeline-event-marker--stack-0 {
    top: 1.85rem;
  }
  .timeline-event-marker--capture.timeline-event-marker--stack-1 {
    top: 2.15rem;
  }
  .timeline-event-marker--capture.timeline-event-marker--stack-2 {
    top: 1.55rem;
  }

  .timeline-event-dot {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cc-sand);
    border: 1.5px solid var(--cc-paper-raised);
    box-shadow: 0 0 0 1px var(--cc-line-strong);
    transition: all var(--cc-duration-fast) var(--cc-ease-standard);
  }

  .timeline-event-marker--context .timeline-event-dot {
    background: #8b3a2b;
  }

  .timeline-event-marker:hover .timeline-event-dot,
  .timeline-event-marker:focus-visible .timeline-event-dot {
    transform: scale(1.4);
    background: var(--cc-ink);
  }

  .timeline-event-marker.is-selected .timeline-event-dot {
    transform: scale(1.5);
    background: var(--cc-ink);
    box-shadow: 0 0 0 2px var(--cc-sand);
  }

  .timeline-event-tooltip {
    position: absolute;
    bottom: calc(100% + 4px);
    left: 50%;
    transform: translateX(-50%);
    padding: 0.25rem 0.5rem;
    background: var(--cc-ink);
    color: var(--cc-paper);
    font-size: 0.625rem;
    white-space: nowrap;
    border-radius: var(--cc-radius-xs);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--cc-duration-fast) var(--cc-ease-standard);
    z-index: 10;
  }

  .timeline-event-marker:hover .timeline-event-tooltip,
  .timeline-event-marker:focus-visible .timeline-event-tooltip {
    opacity: 1;
    visibility: visible;
  }

  .timeline-shell__footer {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 0.6875rem;
    color: var(--cc-ink-muted);
  }

  .timeline-shell__note {
    font-style: italic;
  }
</style>
