---
/**
 * src/components/evidence/SourceDrawer.astro
 *
 * Sourced archival provenance drawer. Displays assertion-driven provenance:
 * directly observed source records, explicit inspection states, and upstream archival references.
 */
---

<aside
  id="source-drawer"
  class="source-drawer-shell"
  aria-label="Archival source provenance"
  data-component="source-drawer"
  data-state="closed"
  hidden
>
  <div class="source-drawer-backdrop" data-source-drawer-backdrop></div>
  <div class="source-drawer-panel" role="dialog" aria-modal="true" aria-labelledby="source-drawer-title">
    <header class="source-drawer-header">
      <div class="source-drawer-header__kicker-wrap">
        <p class="panel-kicker">Archival Provenance</p>
      </div>
      <button
        type="button"
        class="inspector-close"
        aria-label="Close source drawer"
        title="Close source drawer (Esc)"
        data-source-drawer-close
      >
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M1 1l12 12M13 1L1 13" />
        </svg>
      </button>
    </header>

    <div class="source-drawer-content">
      <div class="source-drawer-title-group">
        <h2 id="source-drawer-title" class="source-drawer-title" data-source-title tabindex="-1"></h2>
        <p class="source-drawer-subtitle" data-source-subtitle></p>
      </div>

      <div class="source-drawer-body">
        <section class="inspector-section" aria-label="Archive details">
          <p class="panel-kicker">Observed Source Record</p>
          <dl class="inspector-meta">
            <div class="inspector-meta__row">
              <dt>Repository / Host</dt>
              <dd data-source-institution></dd>
            </div>
            <div class="inspector-meta__row">
              <dt>Identifier / Ref</dt>
              <dd data-source-ref class="inspector-mono"></dd>
            </div>
            <div class="inspector-meta__row">
              <dt>Inspection State</dt>
              <dd data-source-inspection-state class="inspector-mono"></dd>
            </div>
            <div class="inspector-meta__row">
              <dt>Creator / Authority</dt>
              <dd data-source-creator></dd>
            </div>
            <div class="inspector-meta__row">
              <dt>Rights Posture</dt>
              <dd data-source-rights class="inspector-mono"></dd>
            </div>
            <div class="inspector-meta__row" data-source-link-row>
              <dt>Source Link</dt>
              <dd>
                <a
                  href="#"
                  target="_blank"
                  rel="noopener noreferrer"
                  data-source-permalink
                  class="inspector-link"
                >
                  View Source Record ↗
                </a>
              </dd>
            </div>
          </dl>
        </section>

        <!-- Upstream Archival Reference Section (when cited via dataset) -->
        <section class="inspector-section" data-source-upstream-section hidden aria-label="Upstream archival reference">
          <p class="panel-kicker">Upstream Archival Reference (Cited by Source)</p>
          <dl class="inspector-meta">
            <div class="inspector-meta__row">
              <dt>Archival Collection</dt>
              <dd data-source-upstream-repo>The National Archives, Kew</dd>
            </div>
            <div class="inspector-meta__row">
              <dt>Archival Reference</dt>
              <dd data-source-upstream-ref class="inspector-mono"></dd>
            </div>
            <div class="inspector-meta__row">
              <dt>Inspection State</dt>
              <dd class="inspector-mono">upstream_cited_only (not independently examined)</dd>
            </div>
          </dl>
          <p class="inspector-note" data-source-upstream-note>
            Seventeenth/eighteenth-century High Court of Admiralty prize court papers cited in IMLM dataset. The physical manuscript at Kew was not independently examined by Charted Currents.
          </p>
        </section>

        <!-- Supporting Assertions Section -->
        <section class="inspector-section" data-source-assertions-section hidden aria-label="Supporting assertions">
          <p class="panel-kicker">Supporting Source Assertions</p>
          <div class="inspector-table-wrap">
            <table class="inspector-crew-table">
              <thead>
                <tr>
                  <th>Field</th>
                  <th>Raw Sourced Value</th>
                </tr>
              </thead>
              <tbody data-source-assertions-tbody></tbody>
            </table>
          </div>
        </section>

        <section class="inspector-section" aria-label="Scholarly attribution">
          <p class="panel-kicker">Scholarly Extraction & Dataset Citation</p>
          <p class="inspector-note" data-source-citation></p>
        </section>

        <section class="inspector-section" aria-label="Audit and derivation notes">
          <p class="panel-kicker">Provenance & Derivation Audit</p>
          <p class="inspector-note" data-source-notes></p>
        </section>
      </div>
    </div>
  </div>
</aside>

<script>
  import type { PublishedSources } from "../../lib/domain/types";
  import { publishedDataUrl } from "../../lib/data/loadPublished";

  const drawer = document.getElementById("source-drawer");
  const panel = document.querySelector<HTMLElement>(".source-drawer-panel");
  const closeBtn = document.querySelector<HTMLButtonElement>("[data-source-drawer-close]");
  const backdrop = document.querySelector<HTMLElement>("[data-source-drawer-backdrop]");
  const titleEl = document.querySelector<HTMLElement>("[data-source-title]");
  const subtitleEl = document.querySelector<HTMLElement>("[data-source-subtitle]");
  const instEl = document.querySelector<HTMLElement>("[data-source-institution]");
  const refEl = document.querySelector<HTMLElement>("[data-source-ref]");
  const inspectionStateEl = document.querySelector<HTMLElement>("[data-source-inspection-state]");
  const creatorEl = document.querySelector<HTMLElement>("[data-source-creator]");
  const rightsEl = document.querySelector<HTMLElement>("[data-source-rights]");
  const citationEl = document.querySelector<HTMLElement>("[data-source-citation]");
  const notesEl = document.querySelector<HTMLElement>("[data-source-notes]");
  const linkRow = document.querySelector<HTMLElement>("[data-source-link-row]");
  const permalink = document.querySelector<HTMLAnchorElement>("[data-source-permalink]");
  const upstreamSection = document.querySelector<HTMLElement>("[data-source-upstream-section]");
  const upstreamRef = document.querySelector<HTMLElement>("[data-source-upstream-ref]");
  const assertionsSection = document.querySelector<HTMLElement>("[data-source-assertions-section]");
  const assertionsTbody = document.querySelector<HTMLElement>("[data-source-assertions-tbody]");

  let sourcesCache: PublishedSources | null = null;
  let returnElement: HTMLElement | null = null;

  async function loadSources(): Promise<PublishedSources | null> {
    if (sourcesCache) return sourcesCache;
    try {
      const res = await fetch(publishedDataUrl("sources"));
      if (!res.ok) return null;
      sourcesCache = await res.json();
      return sourcesCache;
    } catch {
      return null;
    }
  }

  loadSources();

  export async function openSourceDrawer(options: {
    sourceId?: string | null;
    assertionIds?: string[] | null;
    upstreamRef?: string | null;
    triggerEl?: HTMLElement | null;
  }): Promise<void> {
    if (!drawer) return;
    returnElement = options.triggerEl || (document.activeElement as HTMLElement);

    const sources = await loadSources();
    if (!sources) return;

    let targetSource = options.sourceId ? sources.sources.find((s) => s.id === options.sourceId) : null;
    let targetRecord = null;
    const resolvedAssertions = [];

    if (options.assertionIds && options.assertionIds.length > 0) {
      for (const astId of options.assertionIds) {
        const ast = sources.assertions.find((a) => a.id === astId);
        if (ast) {
          resolvedAssertions.push(ast);
          if (!targetRecord) {
            targetRecord = sources.source_records.find((r) => r.id === ast.source_record_id);
          }
        }
      }
    }

    if (targetRecord && !targetSource) {
      targetSource = sources.sources.find((s) => s.id === targetRecord.source_id) || null;
    }

    if (!targetSource && sources.sources.length > 0) {
      targetSource = sources.sources[0];
    }

    if (!targetSource) return;

    if (titleEl) titleEl.textContent = targetSource.title;
    if (subtitleEl) subtitleEl.textContent = `${targetSource.holding_institution} · ${targetSource.stable_identifier}`;
    if (instEl) instEl.textContent = targetSource.holding_institution;
    if (refEl) refEl.textContent = targetRecord ? `${targetRecord.native_identifier} (${targetSource.stable_identifier})` : targetSource.stable_identifier;
    if (inspectionStateEl) {
      inspectionStateEl.textContent = targetRecord?.inspection_state || "digital_content_inspected";
    }
    if (creatorEl) creatorEl.textContent = targetSource.creator;
    if (rightsEl) rightsEl.textContent = targetSource.rights_posture;
    if (citationEl) citationEl.textContent = targetSource.credit_line;
    if (notesEl) notesEl.textContent = targetSource.notes || "Sourced historical record verified by Charted Currents.";

    if (permalink && linkRow) {
      if (targetSource.item_url) {
        permalink.href = targetSource.item_url;
        linkRow.hidden = false;
      } else {
        linkRow.hidden = true;
      }
    }

    // Upstream reference section
    const effectiveUpstreamRef = options.upstreamRef || targetRecord?.upstream_archive_reference;
    if (upstreamSection && upstreamRef) {
      if (effectiveUpstreamRef) {
        upstreamRef.textContent = effectiveUpstreamRef;
        upstreamSection.hidden = false;
      } else {
        upstreamSection.hidden = true;
      }
    }

    // Render resolved assertions table
    if (assertionsSection && assertionsTbody) {
      if (resolvedAssertions.length > 0) {
        assertionsSection.hidden = false;
        assertionsTbody.replaceChildren();
        for (const ast of resolvedAssertions) {
          const tr = document.createElement("tr");
          const tdField = document.createElement("td");
          tdField.textContent = ast.field.replace(/_/g, " ");

          const tdVal = document.createElement("td");
          const rawVal = ast.raw_value || ast.raw_title || ast.place_name || ast.title || ast.location_raw || ast.date_as_recorded || JSON.stringify(ast);
          tdVal.textContent = String(rawVal);
          tdVal.className = "inspector-mono";

          tr.append(tdField, tdVal);
          assertionsTbody.appendChild(tr);
        }
      } else {
        assertionsSection.hidden = true;
      }
    }

    drawer.hidden = false;
    drawer.setAttribute("data-state", "open");
    titleEl?.focus();
  }

  function closeSourceDrawer(): void {
    if (!drawer) return;
    drawer.setAttribute("data-state", "closed");
    drawer.hidden = true;
    returnElement?.focus();
  }

  closeBtn?.addEventListener("click", closeSourceDrawer);
  backdrop?.addEventListener("click", closeSourceDrawer);

  // Escape keydown with capture isolation
  window.addEventListener(
    "keydown",
    (e) => {
      if (e.key === "Escape" && drawer && !drawer.hidden && drawer.getAttribute("data-state") === "open") {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        closeSourceDrawer();
      }
    },
    { capture: true },
  );

  // Modal Focus Trap: Tab / Shift+Tab containment within drawer
  panel?.addEventListener("keydown", (e: KeyboardEvent) => {
    if (e.key !== "Tab") return;
    const focusable = panel.querySelectorAll<HTMLElement>(
      'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
    );
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  window.addEventListener("cc:open-source", ((e: CustomEvent<{ sourceId?: string; assertionIds?: string[]; triggerEl?: HTMLElement; upstreamRef?: string }>) => {
    if (e.detail) {
      openSourceDrawer({
        sourceId: e.detail.sourceId,
        assertionIds: e.detail.assertionIds,
        triggerEl: e.detail.triggerEl,
        upstreamRef: e.detail.upstreamRef,
      });
    }
  }) as EventListener);
</script>

<style>
  .source-drawer-shell {
    position: fixed;
    inset: 0;
    z-index: 900;
    display: flex;
    justify-content: flex-end;
  }

  .source-drawer-shell[hidden] {
    display: none;
  }

  .source-drawer-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(18, 26, 30, 0.45);
    transition: opacity 180ms ease;
  }

  .source-drawer-panel {
    position: relative;
    width: 100%;
    max-width: 460px;
    height: 100%;
    background: var(--cc-paper-raised);
    border-left: 1px solid var(--cc-line);
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.18);
    display: flex;
    flex-direction: column;
    z-index: 1;
    overflow-y: auto;
  }

  .source-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--cc-line);
    background: var(--cc-paper);
  }

  .source-drawer-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .source-drawer-title {
    font-family: var(--cc-font-serif);
    font-size: var(--cc-text-lg);
    font-weight: 400;
    color: var(--cc-ink);
    margin: 0 0 0.35rem;
  }

  .source-drawer-subtitle {
    font-family: var(--cc-font-sans);
    font-size: var(--cc-text-xs);
    color: var(--cc-ink-muted);
    margin: 0;
  }

  @media (max-width: 767px) {
    .source-drawer-panel {
      max-width: 100%;
    }
  }
</style>
