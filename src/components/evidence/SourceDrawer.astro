---
/**
 * src/components/evidence/SourceDrawer.astro
 *
 * Sourced archival provenance drawer. Displays multi-source evidence grouped
 * by source record, explicit inspection states, and human-readable assertions.
 */
import entities from "../../../public/data/entities.json";
import { withBase } from "../../lib/paths";
const referenceImages = entities.visuals.filter((visual) => visual.rights_state === "open_public_domain" && visual.asset_path);
---

{referenceImages.map((visual) => (
  <template data-source-visual={visual.source_id}>
    <figure class="source-reference-image">
      <a href={withBase(visual.asset_path)} target="_blank" rel="noopener noreferrer" aria-label={`Open published reference image: ${visual.title}`}>
        <img src={withBase(visual.asset_path)} alt={visual.title} loading="lazy" decoding="async" />
      </a>
      <figcaption>
        <p>Published reference image · {visual.date_display}</p>
        <p>{visual.credit_line} · {visual.call_number}</p>
        <a href={visual.item_url} target="_blank" rel="noopener noreferrer">Institutional catalogue ↗</a>
        <span> · Public domain · Select image to inspect</span>
      </figcaption>
    </figure>
  </template>
))}

<aside
  id="source-drawer"
  class="source-drawer-shell"
  aria-label="Archival source provenance"
  data-component="source-drawer"
  data-state="closed"
  hidden
>
  <div class="source-drawer-backdrop" data-source-drawer-backdrop></div>
  <div class="source-drawer-panel" role="dialog" aria-modal="true" aria-labelledby="source-drawer-title">
    <header class="source-drawer-header">
      <div class="source-drawer-header__kicker-wrap">
        <p class="panel-kicker">Evidence & Provenance</p>
      </div>
      <button
        type="button"
        class="inspector-close"
        aria-label="Close source drawer"
        title="Close source drawer (Esc)"
        data-source-drawer-close
      >
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M1 1l12 12M13 1L1 13" />
        </svg>
      </button>
    </header>

    <div class="source-drawer-content">
      <div class="source-drawer-title-group">
        <h2 id="source-drawer-title" class="source-drawer-title" data-source-title tabindex="-1">
          Historical Evidence & Provenance
        </h2>
        <p class="source-drawer-subtitle" data-source-subtitle>
          Sourced archival depositions, contemporary publications, and cartographic references.
        </p>
      </div>

      <div class="source-drawer-body" data-source-cards-container>
        <!-- Dynamic source record cards rendered by JavaScript -->
      </div>
    </div>
  </div>
</aside>

<script>
  import type { PublishedSources } from "../../lib/domain/types";
  import { loadPublishedSources } from "../../lib/data/loadPublished";
  import { selectionStore } from "../../lib/state/selection";
  import { CURRENT_SELECTION_FOCUS_EVENT } from "../../lib/map/interactionState";

  const drawer = document.getElementById("source-drawer");
  const panel = document.querySelector<HTMLElement>(".source-drawer-panel");
  const closeBtn = document.querySelector<HTMLButtonElement>("[data-source-drawer-close]");
  const backdrop = document.querySelector<HTMLElement>("[data-source-drawer-backdrop]");
  const titleEl = document.querySelector<HTMLElement>("[data-source-title]");
  const subtitleEl = document.querySelector<HTMLElement>("[data-source-subtitle]");
  const container = document.querySelector<HTMLElement>("[data-source-cards-container]");

  let sourcesCache: PublishedSources | null = null;
  let returnElement: HTMLElement | null = null;
  let openingRequest = 0;
  const lifecycle = new AbortController();
  const { signal } = lifecycle;
  const desktopReading = window.matchMedia("(min-width: 1025px)");
  const shell = document.querySelector<HTMLElement>(".app-shell");
  const inspector = document.getElementById("entity-inspector");
  function syncReadingLayout(): void {
    const spread = desktopReading.matches && drawer?.getAttribute("data-state") === "open";
    if (shell) shell.dataset.readingOpen = String(Boolean(spread));
    if (inspector) inspector.inert = Boolean(spread);
    if (backdrop) (backdrop as HTMLElement).hidden = Boolean(spread);
    panel?.setAttribute("aria-modal", String(!desktopReading.matches));
    if (!desktopReading.matches && drawer?.getAttribute("data-state") === "open" &&
        !panel?.contains(document.activeElement)) titleEl?.focus();
  }
  desktopReading.addEventListener("change", syncReadingLayout);

  async function loadSources(): Promise<PublishedSources | null> {
    if (sourcesCache) return sourcesCache;
    try {
      sourcesCache = await loadPublishedSources();
      return sourcesCache;
    } catch {
      return null;
    }
  }

  export async function openSourceDrawer(options: {
    sourceId?: string | null;
    assertionIds?: string[] | null;
    upstreamRef?: string | null;
    triggerEl?: HTMLElement | null;
  }): Promise<void> {
    if (!drawer || !container) return;
    const request = ++openingRequest;
    returnElement = options.triggerEl || (document.activeElement as HTMLElement);
    container.replaceChildren();
    const loading = document.createElement("p");
    loading.className = "inspector-note";
    loading.setAttribute("role", "status");
    loading.textContent = "Loading the source records…";
    container.appendChild(loading);
    if (titleEl) titleEl.textContent = "Evidence & Provenance";
    if (subtitleEl) subtitleEl.textContent = "";
    drawer.hidden = false;
    drawer.setAttribute("data-state", "open");
    syncReadingLayout();
    container.setAttribute("aria-busy", "true");
    titleEl?.focus();

    // Both are required only on evidence intent; overlap code and data loading.
    const [sources, renderer] = await Promise.all([
      loadSources(),
      import("../../lib/evidence/renderSourceRecords").catch(() => null),
    ]);
    if (request !== openingRequest) return;
    container.removeAttribute("aria-busy");
    if (!renderer) {
      loading.textContent = "The evidence view could not be loaded. Reload the atlas to try again.";
      return;
    }
    if (!sources) {
      loading.textContent = "The source records could not be loaded. You can close this view and try again.";
      return;
    }

    renderer.renderSourceRecords(options, sources, container, titleEl, subtitleEl);
  }

  function closeSourceDrawer(restoreFocus = true): void {
    if (!drawer) return;
    openingRequest++;
    drawer.setAttribute("data-state", "closed");
    drawer.hidden = true;
    syncReadingLayout();
    if (restoreFocus && returnElement?.isConnected) returnElement.focus();
  }

  closeBtn?.addEventListener("click", () => closeSourceDrawer(), { signal });
  backdrop?.addEventListener("click", () => closeSourceDrawer(), { signal });
  const stopSelection = selectionStore.subscribe(() => {
    if (drawer?.getAttribute("data-state") === "open") closeSourceDrawer(false);
  });
  window.addEventListener(CURRENT_SELECTION_FOCUS_EVENT, () => {
    if (drawer?.getAttribute("data-state") === "open") closeSourceDrawer(false);
  }, { capture: true, signal });
  const cleanup = () => {
    openingRequest++;
    lifecycle.abort();
    stopSelection();
    desktopReading.removeEventListener("change", syncReadingLayout);
  };
  document.addEventListener("astro:before-swap", cleanup, { once: true });
  window.addEventListener("pagehide", (event) => { if (!event.persisted) cleanup(); }, { signal });

  window.addEventListener(
    "keydown",
    (e) => {
      if (e.key === "Escape" && drawer && !drawer.hidden && drawer.getAttribute("data-state") === "open") {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        closeSourceDrawer();
      }
    },
    { capture: true, signal }
  );

  panel?.addEventListener("keydown", (e: KeyboardEvent) => {
    if (desktopReading.matches) return;
    if (e.key !== "Tab") return;
    const focusable = Array.from(panel.querySelectorAll<HTMLElement>(
      'button:not([disabled]), summary, [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
    )).filter((element) => {
      if (!element.getClientRects().length) return false;
      // Chromium can retain layout boxes for descendants of closed details.
      // Only that details element's direct summary remains keyboard reachable.
      for (let ancestor = element.parentElement; ancestor; ancestor = ancestor.parentElement) {
        if (ancestor instanceof HTMLDetailsElement && !ancestor.open) {
          const summary = ancestor.querySelector(":scope > summary");
          if (!summary?.contains(element)) return false;
        }
      }
      return true;
    });
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  }, { signal });

  window.addEventListener("cc:open-source", ((e: CustomEvent<{ sourceId?: string; assertionIds?: string[]; triggerEl?: HTMLElement; upstreamRef?: string }>) => {
    if (e.detail) {
      openSourceDrawer({
        sourceId: e.detail.sourceId,
        assertionIds: e.detail.assertionIds,
        triggerEl: e.detail.triggerEl,
        upstreamRef: e.detail.upstreamRef,
      });
    }
  }) as EventListener, { signal });
</script>

<style>
  .source-drawer-shell {
    position: fixed;
    inset: 0;
    z-index: 900;
    display: flex;
    justify-content: flex-end;
  }

  .source-drawer-shell[hidden] {
    display: none;
  }

  .source-drawer-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(18, 26, 30, 0.45);
    transition: opacity 180ms ease;
  }

  .source-drawer-panel {
    position: relative;
    width: 100%;
    max-width: 500px;
    height: 100%;
    background: var(--cc-paper-raised);
    border-left: 1px solid var(--cc-line);
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.18);
    display: flex;
    flex-direction: column;
    z-index: 1;
    overflow-y: auto;
  }

  .source-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--cc-line);
    background: var(--cc-paper);
    position: sticky;
    top: 0;
    z-index: 2;
  }

  .source-drawer-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .source-drawer-title {
    font-family: var(--cc-font-serif);
    font-size: var(--cc-text-lg);
    font-weight: 400;
    color: var(--cc-ink);
    margin: 0 0 0.35rem;
  }

  .source-drawer-subtitle {
    font-family: var(--cc-font-sans);
    font-size: var(--cc-text-xs);
    color: var(--cc-ink-muted);
    margin: 0;
  }

  .source-drawer-body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .source-drawer-panel :global(.source-card),
  .source-card {
    background: var(--cc-paper);
    border: 1px solid var(--cc-line);
    border-radius: var(--cc-radius-sm);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .source-drawer-panel :global(.source-card__title),
  .source-card__title {
    font-family: var(--cc-font-serif);
    font-size: var(--cc-text-base);
    color: var(--cc-ink);
    margin: 0 0 0.25rem;
  }

  .source-drawer-panel :global(.source-card__subtitle),
  .source-card__subtitle {
    font-size: var(--cc-text-xs);
    color: var(--cc-ink-muted);
    margin: 0;
  }

  .source-drawer-panel :global(.source-card__upstream),
  .source-drawer-panel :global(.source-card__facsimile),
  .source-drawer-panel :global(.source-card__assertions),
  .source-drawer-panel :global(.source-card__citation),
  .source-card__upstream,
  .source-card__facsimile,
  .source-card__assertions,
  .source-card__citation {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid color-mix(in srgb, var(--cc-line) 65%, transparent);
  }

  .source-drawer-panel :global(.inspector-facsimile-figure),
  .inspector-facsimile-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .source-drawer-panel :global(.inspector-facsimile-img),
  .inspector-facsimile-img {
    width: 100%;
    max-height: 380px;
    object-fit: contain;
    background: var(--cc-paper-raised);
    border: 1px solid var(--cc-line);
    border-radius: var(--cc-radius-xs);
  }

  .source-drawer-panel :global(.inspector-table-wrap),
  .inspector-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--cc-line);
    border-radius: var(--cc-radius-xs);
    background: var(--cc-paper-raised);
  }

  .source-drawer-panel :global(.inspector-crew-table),
  .inspector-crew-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--cc-text-xs);
    text-align: left;
  }

  .source-drawer-panel :global(.inspector-crew-table th),
  .source-drawer-panel :global(.inspector-crew-table td),
  .inspector-crew-table th,
  .inspector-crew-table td {
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--cc-line);
  }

  .source-drawer-panel :global(.inspector-crew-table th),
  .inspector-crew-table th {
    font-family: var(--cc-font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    color: var(--cc-ink-muted);
    background: color-mix(in srgb, var(--cc-paper) 80%, transparent);
  }

  .source-drawer-panel :global(.inspector-crew-table tr:last-child td),
  .inspector-crew-table tr:last-child td {
    border-bottom: none;
  }

  .source-drawer-panel :global(.inspector-field-badge),
  .inspector-field-badge {
    display: inline-block;
    padding: 0.1rem 0.35rem;
    font-size: 0.62rem;
    font-family: var(--cc-font-mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: color-mix(in srgb, var(--cc-accent-warm, #c26932) 15%, transparent);
    color: var(--cc-accent-warm, #c26932);
    border: 1px solid color-mix(in srgb, var(--cc-accent-warm, #c26932) 35%, transparent);
    border-radius: var(--cc-radius-xs, 2px);
    vertical-align: middle;
  }

  .source-drawer-panel :global(.inspector-rule-note),
  .inspector-rule-note {
    font-size: 0.65rem;
    color: var(--cc-ink-muted);
    font-style: italic;
    margin-top: 0.2rem;
  }

  @media (max-width: 767px) {
    .source-drawer-panel {
      max-width: 100%;
    }
  }
</style>
